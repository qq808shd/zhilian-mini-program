:host { display:block; }
.tab-bar { position:fixed; z-index:100; left:0; right:0; bottom:0; padding-bottom:env(safe-area-inset-bottom); background:#FFFFFF; border-top:1rpx solid #E8E9E3; box-sizing:content-box; }
.tab-items { display:flex; height:48px; }
.tab-item { display:flex; flex:1; flex-direction:column; align-items:center; justify-content:center; gap:2px; min-width:0; width:0; height:48px; padding:2px 0; margin:0; box-sizing:border-box; border:0; border-radius:0; background:transparent; color:#68736C; line-height:1; }
.tab-item::after { border:0; }
.tab-icon { display:block; width:24px; height:24px; flex-shrink:0; }
.tab-label { display:block; font-size:11px; line-height:14px; }
.is-selected { color:#4D785B; }
.is-selected .tab-label { font-weight:600; }
.tab-pressed { background:#EDF3E8!important; }
