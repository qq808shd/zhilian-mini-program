:host { display: block; }
.state { padding: 56rpx 32rpx; text-align: center; border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
.mark { display: block; margin-bottom: 20rpx; font-size: 42rpx; color: var(--color-primary); }
.title { display: block; color: var(--color-text); font-size: 31rpx; font-weight: 650; }
.description { display: block; margin-top: 16rpx; color: var(--color-text-secondary); font-size: 26rpx; line-height: 1.7; }
.action { display: flex; width: 100% !important; min-height: 92rpx; box-sizing: border-box; margin: 28rpx 0 0; align-items: center; justify-content: center; padding: 12rpx; border-radius: var(--radius-md); background: var(--color-primary-soft); color: var(--color-primary); font-size: 27rpx; line-height: 1.4; }
.action::after { border: none; }
.pressed { opacity: .8; }
