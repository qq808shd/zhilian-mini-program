:host { display: block; width: 100%; }
.entry { box-sizing: border-box; display: flex; width: 100% !important; max-width: none; min-height: 140rpx; margin: 0; padding: 28rpx; align-items: center; gap: 24rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); text-align: left; line-height: 1.5; }
.entry::after { border: none; }
.symbol { display: flex; width: 64rpx; height: 64rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: var(--radius-sm); background: var(--color-primary-soft); color: var(--color-primary); font-size: 30rpx; font-weight: 600; }
.body { flex: 1; min-width: 0; }
.title { display: block; color: var(--color-text); font-size: 32rpx; font-weight: 650; }
.description, .meta { display: block; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 25rpx; }
.meta { font-size: 23rpx; }
.badge { display: inline-block; margin-top: 12rpx; color: var(--color-primary); font-size: 23rpx; }
.badge.warning { color: var(--color-warning); }
.arrow { flex-shrink: 0; font-size: 36rpx; color: var(--color-text-tertiary); }
.pressed { background: var(--color-primary-soft); border-color: var(--color-primary-border); }
