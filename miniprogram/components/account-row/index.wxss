:host{display:block;width:100%}.row{display:flex;align-items:center;gap:24rpx;width:100%!important;min-height:112rpx;margin:0;padding:24rpx 28rpx;background:var(--color-surface);border-radius:0;border-bottom:1rpx solid var(--color-divider);text-align:left;line-height:1.5}.row::after{border:none}.icon{width:40rpx;height:40rpx;flex-shrink:0}.title{flex:1;min-width:0;font-size:29rpx;color:var(--color-text)}.detail{max-width:44%;font-size:25rpx;color:var(--color-text-secondary);text-align:right;word-break:break-all}.arrow{font-size:36rpx;color:var(--color-text-tertiary);flex-shrink:0}.danger .title{color:var(--color-danger)}.pressed{background:var(--color-primary-soft)}
