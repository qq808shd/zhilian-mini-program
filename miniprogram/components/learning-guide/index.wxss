:host { font-size:28rpx; color:var(--color-text); }
.guide-backdrop { position:fixed; inset:0; z-index:200; display:flex; justify-content:flex-end; flex-direction:column; background:rgba(32,45,36,.35); }
.guide-sheet { display:flex; flex-direction:column; box-sizing:border-box; max-height:88vh; padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:var(--color-surface); }
.guide-sheet.is-rules { height:80vh; padding-bottom:0; }
.guide-handle { width:64rpx; height:8rpx; margin:0 auto 16rpx; border-radius:8rpx; background:var(--color-border); }
.guide-heading { display:flex; align-items:center; justify-content:space-between; flex-shrink:0; min-height:48px; gap:24rpx; font-size:30rpx; font-weight:600; line-height:1.4; }
.guide-heading .guide-close { display:flex; align-items:center; justify-content:flex-end; flex:0 0 auto; width:44px; min-width:44px; min-height:44px; margin:0; padding:0; background:transparent; color:var(--color-primary); font-size:26rpx; line-height:1.4; }
.is-rules .guide-heading { padding-bottom:8rpx; border-bottom:1rpx solid var(--color-border); }
.guide-rules .guide-more { display:flex; align-items:center; justify-content:flex-start; width:100%; min-height:44px; margin:8rpx 0; padding:0; background:transparent; color:var(--color-primary); font-size:26rpx; line-height:1.4; }
.guide-close::after,.guide-more::after,.guide-primary::after { border:0; }
.guide-scroll { min-height:0; height:56vh; }
.is-rules .guide-scroll { flex:1; height:0; }
.guide-step { padding:32rpx 16rpx; text-align:center; }
.guide-art { display:block; width:112rpx; height:112rpx; margin:24rpx auto 40rpx; }
.guide-title { display:block; font-size:42rpx; font-weight:600; margin-bottom:24rpx; }
.guide-body { display:block; font-size:28rpx; line-height:1.7; color:var(--color-text-secondary); white-space:pre-line; }
.guide-ending { display:block; margin-top:32rpx; font-size:24rpx; line-height:1.6; color:var(--color-text-secondary); }
.rule-title { display:block; margin:24rpx 0 8rpx; font-size:30rpx; font-weight:600; }
.guide-rules { padding:8rpx 0 calc(16rpx + env(safe-area-inset-bottom)); }
.guide-rules > .guide-body { margin-bottom:16rpx; }
.guide-sheet .guide-primary { flex-shrink:0; display:flex; align-items:center; justify-content:center; min-height:96rpx; width:100%; margin:24rpx 0 0; border-radius:20rpx; background:var(--color-primary); color:white; font-size:28rpx; }
