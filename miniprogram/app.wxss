page {
  --color-primary: #2563eb;
  --color-primary-dark: #1d4ed8;
  --color-primary-soft: #eaf2ff;
  --color-accent: #16a36a;
  --color-danger: #dc3f3f;
  --color-warning: #e59a25;
  --color-text: #0f1f3d;
  --color-text-secondary: #64748b;
  --color-border: #e1eafb;
  --color-surface: #ffffff;
  --color-background: #f4f8ff;
  background: var(--color-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 30rpx;
}

view,
text,
scroll-view,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.2;
}

button[class] {
  margin-left: 0;
  margin-right: 0;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  display: block;
  color: var(--color-text);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  line-height: 1.6;
}

.section {
  margin-top: 32rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 650;
}

.section-note {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.card {
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: var(--color-surface);
  box-shadow: 0 10rpx 30rpx rgba(37, 99, 235, 0.08);
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: 22rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.2;
}

.primary-button {
  background: var(--color-primary);
  color: #ffffff;
}

.primary-button[disabled] {
  background: #a9c5fa;
  color: #ffffff;
}

.secondary-button {
  border: 2rpx solid #c9dcff;
  background: #ffffff;
  color: var(--color-primary-dark);
}

.danger-button {
  border: 2rpx solid #f0caca;
  background: #fff8f8;
  color: #bf3434;
}

.empty-state {
  padding: 72rpx 40rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: var(--color-text);
  font-size: 31rpx;
  font-weight: 650;
}

.empty-description {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}
