page {
  /* 知练 Design System · Calm Focus */
  --color-primary: #2457d6;
  --color-primary-dark: #1d46b8;
  --color-primary-soft: #eef4ff;
  --color-secondary: #0f8f83;
  --color-secondary-soft: #eaf8f5;
  --color-background: #f6f8fc;
  --color-surface: #ffffff;
  --color-surface-muted: #f8fafd;
  --color-text: #172033;
  --color-text-secondary: #5b667a;
  --color-text-tertiary: #6b7588;
  --color-border: #e2e8f2;
  --color-divider: #ecf0f6;
  --color-success: #0b7654;
  --color-success-soft: #e9f7f1;
  --color-danger: #c8464c;
  --color-danger-soft: #fff0f1;
  --color-warning: #b7791f;
  --color-warning-soft: #fff8e8;
  --color-disabled: #c7cfdb;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --shadow-card: 0 8rpx 24rpx rgba(35, 55, 91, 0.055);
  --shadow-raised: 0 14rpx 36rpx rgba(35, 55, 91, 0.09);
  min-height: 100%;
  background: var(--color-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 30rpx;
}

view,
text,
scroll-view,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.2;
}

button[class] {
  margin-left: 0;
  margin-right: 0;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 36rpx 28rpx calc(72rpx + env(safe-area-inset-bottom));
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  color: var(--color-text);
  font-size: 46rpx;
  font-weight: 720;
  letter-spacing: -1rpx;
  line-height: 1.28;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  line-height: 1.65;
}

.eyebrow,
.crumb {
  display: block;
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.section {
  margin-top: 40rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  color: var(--color-text);
  font-size: 31rpx;
  font-weight: 680;
  line-height: 1.4;
}

.section-note {
  margin-left: 20rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
  line-height: 1.4;
  text-align: right;
}

.card {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  border-radius: var(--radius-md);
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.2;
  transition: transform 120ms ease, background-color 160ms ease, border-color 160ms ease;
}

.primary-button {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(36, 87, 214, 0.18);
}

.primary-button[disabled] {
  background: #aec2ee;
  color: rgba(255, 255, 255, 0.9);
  box-shadow: none;
}

.secondary-button {
  border: 2rpx solid #bfd0f2;
  background: #ffffff;
  color: var(--color-primary-dark);
}

.danger-button {
  border: 2rpx solid #efc8cb;
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.empty-state {
  padding: 76rpx 42rpx;
  text-align: center;
}

.empty-mark {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 22rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.empty-title {
  display: block;
  color: var(--color-text);
  font-size: 31rpx;
  font-weight: 680;
}

.empty-description {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
}

.interactive-card {
  transition: transform 120ms ease, background-color 160ms ease, border-color 160ms ease;
}

.interactive-card-hover {
  border-color: #cbd9ef;
  background: #fbfcff;
  transform: scale(0.992);
}
