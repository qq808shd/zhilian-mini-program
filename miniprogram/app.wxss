@import "styles/account.wxss";

page {
  /* 知练 Design System · Quiet Growth */
  --color-primary: #4d785b;
  --color-primary-dark: #303d36;
  --color-primary-soft: #edf3e8;
  --color-secondary: #526e4b;
  --color-secondary-soft: #edf3e8;
  --color-background: #f8f7f3;
  --color-surface: #ffffff;
  --color-surface-muted: #f3f5ef;
  --color-text: #303d36;
  --color-text-secondary: #68736c;
  --color-text-tertiary: #68736c;
  --color-border: #e8e9e3;
  --color-divider: #e7ebe2;
  --color-success: #356b4f;
  --color-success-soft: #ecf5ed;
  --color-danger: #ad5146;
  --color-danger-soft: #fcf0eb;
  --color-warning: #86662f;
  --color-warning-soft: #faf4e7;
  --color-disabled: #7b897d;
  --color-on-primary: #ffffff;
  --color-primary-border: #bbcdb7;
  --color-danger-border: #e6bfb6;
  --color-warning-border: #e3d3ae;
  --color-track: #dfe7dd;
  --color-pressed: #e5edde;
  --color-disabled-background: #dce5d9;
  --shadow-button: 0 4rpx 10rpx rgba(40, 53, 44, .06);
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 28rpx;
  --shadow-card: 0 8rpx 24rpx rgba(40, 53, 44, 0.025);
  --shadow-raised: 0 14rpx 36rpx rgba(40, 53, 44, 0.045);
  min-height: 100%;
  background: var(--color-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 30rpx;
}

view,
text,
scroll-view,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.2;
}

button[class] {
  margin-left: 0;
  margin-right: 0;
}

button::after {
  border: none;
}

.page {
  min-height: 100%;
  padding: 32rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  color: var(--color-text);
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.28;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  line-height: 1.65;
}

.eyebrow,
.crumb {
  display: block;
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.section {
  margin-top: 40rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  color: var(--color-text);
  font-size: 31rpx;
  font-weight: 680;
  line-height: 1.4;
}

.section-note {
  margin-left: 20rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
  line-height: 1.4;
  text-align: right;
}

.card {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

/* 微信会给普通 button 注入固定宽度；列表与目录卡片统一覆盖为容器全宽。 */
.page button.card,
.page button.catalog-card {
  width: 100%;
  max-width: none;
  margin-left: 0;
  margin-right: 0;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  border-radius: 20rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.2;
  transition: transform 120ms ease, background-color 160ms ease, border-color 160ms ease;
}

.primary-button {
  background: var(--color-primary);
  color: var(--color-on-primary);
  box-shadow: 0 8rpx 18rpx rgba(40, 53, 44, .06);
}

.primary-button[disabled] {
  background: var(--color-disabled-background);
  color: var(--color-text-secondary);
  box-shadow: none;
}

.secondary-button {
  border: 2rpx solid var(--color-primary-border);
  background: var(--color-surface);
  color: var(--color-primary-dark);
}

.danger-button {
  border: 2rpx solid var(--color-danger-border);
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.empty-state {
  padding: 76rpx 42rpx;
  text-align: center;
}

.empty-mark {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 22rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.empty-title {
  display: block;
  color: var(--color-text);
  font-size: 31rpx;
  font-weight: 680;
}

.empty-description {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
}

.interactive-card {
  transition: transform 120ms ease, background-color 160ms ease, border-color 160ms ease;
}

.interactive-card-hover {
  border-color: var(--color-primary-border);
  background: var(--color-pressed);
  transform: scale(0.992);
}

/* Reusable layout primitives. Keep primary actions full width under WeChat style v2. */
button.primary-button, button.secondary-button, button.danger-button { width: 100%; min-width: 0; }
button.text-button { display: flex; min-height: 88rpx; width: auto !important; flex-shrink: 0; align-items: center; justify-content: center; padding: 0 12rpx; background: transparent; color: var(--color-primary); font-size: 26rpx; font-weight: 600; }
button[disabled] { box-shadow: none; }
.secondary-button[disabled] { background: var(--color-surface-muted); color: var(--color-disabled); border-color: var(--color-border); }
.button-pressed { opacity: .82; }
.stack { display: flex; flex-direction: column; gap: 16rpx; }
.actions-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.actions-row button { flex: 1; min-width: 0; }
.kicker { display: block; color: var(--color-primary); font-size: 23rpx; font-weight: 600; letter-spacing: 3rpx; }
.muted { color: var(--color-text-secondary); }
.status-note { display: block; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.7; }
.inset-note { padding: 24rpx; border-radius: var(--radius-md); background: var(--color-primary-soft); }
.pill { display: inline-block; padding: 6rpx 14rpx; border-radius: var(--radius-sm); background: var(--color-primary-soft); color: var(--color-primary); font-size: 23rpx; line-height: 1.5; }
.pill-warning { color: var(--color-warning); background: var(--color-warning-soft); }
.metrics { display: flex; padding: 28rpx 8rpx; }
.metric { flex: 1; min-width: 0; text-align: center; }
.metric + .metric { border-left: 1rpx solid var(--color-border); }
.metric-value { display: block; font-size: 38rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.metric-label { display: block; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 23rpx; }
@media (prefers-reduced-motion: reduce) { button, view { transition: none !important; animation: none !important; } }
@media (min-width: 600px) { .page { max-width: 1000rpx; margin: 0 auto; } }
