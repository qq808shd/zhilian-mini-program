@import "learning-theme.wxss";
.group-page { padding:32rpx 32rpx calc(128rpx + env(safe-area-inset-bottom)); font-size:28rpx; line-height:1.5; }
.group-page text { overflow-wrap:break-word; }
.g-card { margin-bottom:24rpx; padding:32rpx; border:1rpx solid var(--color-border); border-radius:24rpx; background:var(--color-surface); }
.g-title { display:block; font-size:36rpx; font-weight:600; line-height:1.4; }
.g-heading { display:block; font-size:32rpx; font-weight:600; line-height:1.4; }
.g-sub { display:block; color:var(--color-text-secondary); font-size:24rpx; line-height:1.6; }
.g-small { font-size:22rpx; color:var(--color-text-secondary); }
.g-row { display:flex; align-items:center; gap:16rpx; }
.g-between { display:flex; justify-content:space-between; align-items:center; gap:16rpx; }
.g-wrap { flex-wrap:wrap; }
.g-gap { margin-top:24rpx; }
.g-gap-sm { margin-top:16rpx; }
.g-number { font-size:52rpx; font-weight:600; line-height:1.2; font-variant-numeric:tabular-nums; color:var(--color-primary); }
.g-page button { box-sizing:border-box; }
.group-page button.g-button, .g-sheet button.g-button { display:flex; align-items:center; justify-content:center; width:100%; min-width:0; height:88rpx; padding:0 24rpx; border-radius:20rpx; background:var(--color-primary); color:#fff; font-size:28rpx; font-weight:500; }
.group-page button.g-secondary, .g-sheet button.g-secondary { height:80rpx; background:var(--color-surface); color:var(--color-primary); border:1rpx solid var(--color-primary-border); }
.group-page button.g-link, .g-sheet button.g-link { display:flex; align-items:center; justify-content:center; width:auto; max-width:100%; min-height:64rpx; padding:8rpx 12rpx; border-radius:16rpx; background:transparent; color:var(--color-primary); font-size:24rpx; line-height:1.4; }
.group-page button[disabled], .g-sheet button[disabled] { opacity:.5; }
.g-actions { display:flex; gap:16rpx; align-items:center; }
.g-actions button { flex:1; width:0!important; }
.g-actions .g-link { flex:0 0 auto; }
.g-label { display:block; margin:24rpx 0 12rpx; font-size:28rpx; font-weight:500; }
.g-input { display:block; width:100%; height:88rpx; padding:0 24rpx; border-radius:16rpx; border:1rpx solid var(--color-border); background:var(--color-surface-muted); font-size:28rpx; }
.g-error { display:block; margin:16rpx 0; padding:16rpx 24rpx; border-radius:16rpx; background:var(--color-danger-soft); color:var(--color-danger); font-size:24rpx; }
.g-empty { text-align:center; padding:48rpx 16rpx; }
.g-illustration { display:block; width:320rpx; height:224rpx; margin:0 auto 32rpx; }
.g-empty .g-sub { margin:16rpx 0 32rpx; }
.g-icon { width:32rpx; height:32rpx; flex-shrink:0; }
.g-avatar { display:block; width:72rpx; height:72rpx; border-radius:999rpx; flex-shrink:0; }
.g-pill { display:inline-flex; align-items:center; gap:8rpx; padding:4rpx 12rpx; border-radius:16rpx; font-size:22rpx; }
.g-success { color:var(--color-success); background:var(--color-success-soft); }
.g-warning { color:var(--color-warning); background:var(--color-warning-soft); }
.g-danger { color:var(--color-danger); background:var(--color-danger-soft); }
.g-leave { color:var(--learning-blue); background:var(--learning-blue-soft); }
.g-observer { color:var(--color-warning); background:var(--color-warning-soft); }
.g-neutral,.g-empty-tone { color:var(--color-text-secondary); background:var(--color-surface-muted); }
.g-muted { color:var(--color-text-secondary); }
.g-divider { margin:24rpx 0; height:1rpx; background:var(--color-divider); }
.g-backdrop { position:fixed; z-index:200; inset:0; background:rgba(32,45,36,.35); display:flex; flex-direction:column; justify-content:flex-end; }
.g-sheet { max-height:88vh; overflow-y:auto; border-radius:32rpx 32rpx 0 0; padding:32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); background:var(--color-surface); color:var(--color-text); }
.g-sheet .g-input { font-size:44rpx; height:96rpx; }
.g-sheet .g-sheet-handle { width:64rpx; height:8rpx; background:var(--color-border); border-radius:999rpx; margin:0 auto 24rpx; }
.g-sheet-title { font-size:32rpx; font-weight:600; }
.g-sheet .g-contract-line { display:block; font-size:26rpx; margin-top:24rpx; line-height:1.7; }
.g-sheet .g-member-stat { padding:16rpx 0; border-bottom:1rpx solid var(--color-divider); }
.g-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16rpx; }
.g-stat-value { display:block; font-size:36rpx; font-weight:600; color:var(--color-primary); font-variant-numeric:tabular-nums; }
.g-check { display:flex; align-items:flex-start; gap:12rpx; margin:24rpx 0; font-size:24rpx; }
.g-check checkbox { transform:scale(.8); transform-origin:left top; width:40rpx; flex-shrink:0; }
.g-pressed { opacity:.8; }
