.catalog-page { padding-top:26rpx; }
.crumb { display:block; color:var(--color-primary); font-size:23rpx; font-weight:650; }
.catalog-title { margin-top:14rpx; }
.search-panel { display:flex; min-height:100rpx; align-items:center; margin-top:30rpx; padding:0 14rpx 0 26rpx; border:2rpx solid #ccdcf7; border-radius:26rpx; background:#fff; box-shadow:0 10rpx 28rpx rgba(37,99,235,.07); }
.search-label { flex:0 0 auto; color:var(--color-primary); font-size:25rpx; font-weight:700; }
.search-input { min-width:0; height:96rpx; flex:1; margin-left:20rpx; color:var(--color-text); font-size:29rpx; }
.search-placeholder { color:#94a3b8; }
.clear-button { display:flex; min-width:88rpx; min-height:88rpx; align-items:center; justify-content:center; margin-left:12rpx; padding:0 18rpx; border-radius:18rpx; background:#edf4ff; color:#3869b6; font-size:24rpx; font-weight:650; }
.clear-hover { background:#dfeaff; }
.result-heading { display:flex; align-items:center; justify-content:space-between; margin:30rpx 4rpx 18rpx; }
.result-label { color:var(--color-text); font-size:27rpx; font-weight:680; }
.result-total { color:var(--color-text-secondary); font-size:23rpx; }
.result-list { display:flex; flex-direction:column; gap:18rpx; }
.result-card { padding:30rpx; }
.result-card-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; }
.word-heading { display:flex; min-width:0; align-items:center; }
.word-order { display:flex; width:48rpx; height:48rpx; flex:0 0 auto; align-items:center; justify-content:center; border-radius:15rpx; background:var(--color-primary-soft); color:var(--color-primary); font-size:21rpx; font-weight:700; }
.word-title { margin-left:16rpx; color:var(--color-text); font-size:38rpx; font-weight:730; line-height:1.3; word-break:break-all; }
.word-category { max-width:190rpx; padding:8rpx 13rpx; border-radius:14rpx; background:#f1f5fb; color:#5b7190; font-size:21rpx; line-height:1.35; text-align:center; }
.meaning-label { display:block; margin-top:28rpx; color:var(--color-primary); font-size:22rpx; font-weight:720; }
.meaning-text { display:block; margin-top:10rpx; color:#334866; font-size:28rpx; line-height:1.75; }
.detail-toggle { display:flex; width:100%; min-height:88rpx; align-items:center; justify-content:center; margin-top:24rpx; padding:0 24rpx; border-radius:20rpx; background:#edf4ff; color:#2f63b4; font-size:26rpx; font-weight:650; }
.detail-toggle-hover { background:#dfeaff; }
.detail-panel { margin-top:22rpx; padding:24rpx; border-radius:20rpx; background:#f7faff; }
.detail-label { display:block; color:#5274a4; font-size:22rpx; font-weight:700; }
.detail-text { display:block; margin-top:9rpx; color:#405675; font-size:27rpx; line-height:1.75; white-space:pre-wrap; }
.load-more { display:flex; width:100%; min-height:96rpx; align-items:center; justify-content:center; margin-top:8rpx; padding:0 24rpx; border:2rpx solid #cbdcf7; border-radius:22rpx; background:#f7faff; color:#2f63b4; font-size:26rpx; font-weight:680; }
.load-more-hover { background:#eaf2ff; }
.list-end { display:block; padding:28rpx 0 12rpx; color:#8291a8; font-size:23rpx; text-align:center; }
.empty-state { margin-top:18rpx; }
.empty-clear { display:flex; width:100%; min-height:88rpx; align-items:center; justify-content:center; margin-top:28rpx; padding:0 24rpx; border-radius:20rpx; background:var(--color-primary); color:#fff; font-size:27rpx; font-weight:650; }
.empty-clear-hover { background:var(--color-primary-dark); }
