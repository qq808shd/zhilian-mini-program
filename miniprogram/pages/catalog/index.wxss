.catalog-page {
  padding-top: 28rpx;
}

.catalog-title {
  margin-top: 14rpx;
}

.search-panel {
  display: flex;
  min-height: 98rpx;
  align-items: center;
  margin-top: 32rpx;
  padding: 0 12rpx 0 24rpx;
  border: 2rpx solid var(--color-primary-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.search-mark {
  position: relative;
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
}

.search-mark-ring {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 21rpx;
  height: 21rpx;
  border: 3rpx solid var(--color-primary);
  border-radius: 50%;
}

.search-mark-handle {
  position: absolute;
  top: 25rpx;
  left: 25rpx;
  width: 13rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--color-primary);
  transform: rotate(45deg);
  transform-origin: left center;
}

.search-input {
  min-width: 0;
  height: 94rpx;
  flex: 1;
  margin-left: 18rpx;
  color: var(--color-text);
  font-size: 28rpx;
}

.search-placeholder {
  color: var(--color-text-secondary);
}

.clear-button {
  display: flex;
  min-width: 88rpx;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  font-size: 24rpx;
  font-weight: 650;
}

.clear-hover,
.detail-toggle-hover,
.load-more-hover {
  background: var(--color-pressed);
}

.result-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 4rpx 20rpx;
}

.result-label {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 680;
}

.result-total {
  color: var(--color-text-secondary);
  font-size: 23rpx;
  font-weight: 600;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.result-card {
  padding: 30rpx;
}

.result-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.word-heading {
  display: flex;
  min-width: 0;
  align-items: center;
}

.word-order {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 700;
}

.word-title {
  margin-left: 16rpx;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 720;
  line-height: 1.35;
  word-break: break-all;
}

.word-category {
  max-width: 190rpx;
  padding: 7rpx 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface-muted);
  color: var(--color-text-secondary);
  font-size: 21rpx;
  line-height: 1.35;
  text-align: center;
}

.meaning-label,
.detail-label {
  display: block;
  margin-top: 28rpx;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.meaning-text {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.78;
}

.detail-toggle,
.load-more,
.empty-clear {
  display: flex;
  width: 100%;
  min-height: 90rpx;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  font-weight: 650;
}

.detail-toggle {
  margin-top: 24rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
}

.detail-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border-left: 5rpx solid var(--color-primary-border);
  border-radius: 8rpx var(--radius-md) var(--radius-md) 8rpx;
  background: var(--color-surface-muted);
}

.detail-panel .detail-label {
  margin-top: 0;
}

.detail-text {
  display: block;
  margin-top: 9rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  line-height: 1.78;
  white-space: pre-wrap;
}

.load-more {
  margin-top: 8rpx;
  border: 2rpx solid var(--color-primary-border);
  background: var(--color-surface);
  color: var(--color-primary-dark);
}

.list-end {
  display: block;
  padding: 30rpx 0 12rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
  text-align: center;
}

.empty-state {
  margin-top: 18rpx;
}

.empty-clear {
  margin-top: 28rpx;
  background: var(--color-primary);
  color: var(--color-surface);
}

.empty-clear-hover {
  background: var(--color-primary-dark);
}
