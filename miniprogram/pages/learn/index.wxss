@import "../../styles/learning-controls.wxss";
.learn-page { display:flex; height:100vh; min-height:0; overflow:hidden; flex-direction:column; padding:12px var(--learning-gutter) calc(16px + env(safe-area-inset-bottom)); background:var(--color-background); }
.learn-header { flex-shrink:0; height:44px; margin-bottom:16px; }
.learn-position { display:flex; justify-content:center; align-items:baseline; gap:6px; margin-bottom:12px; font-variant-numeric:tabular-nums; }
.position-current { font-size:18px; font-weight:600; }
.position-total { font-size:14px; color:var(--color-text-secondary); }
.learning-swiper { flex:1; min-height:0; width:100%; }
.is-busy { pointer-events:none; }
.card-scroll { height:100%; }
.learning-card { min-height:100%; padding:12px 20px 28px; border:1px solid #f0efea; border-radius:var(--learning-radius); background:var(--color-surface); box-shadow:var(--learning-shadow); }
.card-meta, .card-tags { display:flex; align-items:center; }
.card-meta { justify-content:space-between; min-height:44px; gap:8px; }
.card-tags { flex-wrap:wrap; gap:8px; }
.card-index, .card-state { color:var(--color-text-secondary); font-size:13px; line-height:1.5; }
.knowledge-title { display:block; margin:56px 0 44px; color:var(--color-text); font-size:30px; font-weight:600; line-height:1.45; text-align:center; word-break:break-word; }
.learning-card .reveal-button { margin:12px auto 48px; width:auto; }
.answer-area { margin-top:0; }
.definition-panel { padding:16px; background:var(--learning-tint); border-radius:16px; }
.answer-label, .memory-label { display:block; color:var(--color-primary); font-size:13px; font-weight:500; }
.definition-text, .answer-detail, .memory-text { display:block; margin-top:12px; color:var(--color-text); font-size:16px; font-weight:400; line-height:28px; white-space:pre-wrap; word-break:break-word; }
.answer-section-divider { height:0; margin:24px 0 0; }
.memory-box { margin-top:24px; padding:16px; border-radius:16px; background:var(--learning-amber-soft); }
.memory-label { color:var(--learning-amber); }
.learn-footer { flex-shrink:0; padding-top:16px; }
.finish-text { display:block; margin-bottom:16px; font-size:16px; color:var(--color-text); text-align:center; }
.finish-links { display:flex; justify-content:center; gap:24px; }
.familiar-continue { margin:auto; }
@media (max-height:500px) { .learn-page { min-height:460px; } }
