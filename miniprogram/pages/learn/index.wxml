<view class="learn-page" wx:if="{{topic}}">
  <view class="learn-header">
    <view class="learn-heading"><text class="learn-crumb">{{module.name}} / {{topic.name}}</text><text class="learn-set">{{setName}}</text></view>
    <view class="learn-counter"><text class="learn-position">{{currentIndex + 1}} / {{total}}</text><text class="learn-percent">{{progressPercent}}%</text></view>
  </view>
  <view class="progress-track">
    <view wx:for="{{learningItems}}" wx:key="id" class="progress-segment {{index <= currentIndex ? 'is-active' : ''}}"></view>
  </view>
  <swiper class="learning-swiper" current="{{swiperCurrent}}" bindchange="onSwiperChange" duration="260">
    <swiper-item wx:for="{{learningItems}}" wx:key="id">
      <scroll-view class="card-scroll" scroll-y>
        <view class="learning-card {{item.revealed ? 'is-revealed' : 'is-prompt'}}">
          <view class="card-meta"><text class="card-index">学习卡片 {{index + 1}}</text><text class="card-state">{{item.revealed ? '已展开解析' : '先回忆'}}</text></view>
          <view class="prompt-area">
            <text class="knowledge-title">{{item.title}}</text>
            <math-formula
              wx:if="{{item.revealed && item.formulaLines && item.formulaLines.length}}"
              lines="{{item.formulaLines}}"
              note="{{item.formulaNote}}"
              spoken="{{item.summary}}"
              size="{{item.formulaSize}}"
            />
            <text wx:if="{{!hideDefinitionBeforeReveal}}" class="knowledge-summary">{{item.formulaLines && item.formulaLines.length ? '先看懂公式结构，再点击查看推导、例题和易错点。' : item.summary}}</text>
            <text wx:elif="{{!item.revealed}}" class="recall-hint">先在心里回想它的含义，再点击查看解析。</text>
            <button wx:if="{{!item.revealed}}" class="reveal-button" hover-class="reveal-hover" data-index="{{index}}" bindtap="onReveal">点击查看解析</button>
          </view>
          <view wx:if="{{item.revealed}}" class="answer-area">
            <view class="answer-divider"></view>
            <block wx:if="{{hideDefinitionBeforeReveal}}">
              <text class="answer-label">释义</text>
              <text class="definition-text">{{item.summary}}</text>
              <block wx:if="{{item.hasSeparateDetail}}">
                <view class="answer-section-divider"></view>
                <text class="answer-label">详细解析</text>
                <text class="answer-detail">{{item.detail}}</text>
              </block>
            </block>
            <block wx:else>
              <text class="answer-label">解析</text>
              <text class="answer-detail">{{item.detail}}</text>
            </block>
            <view wx:if="{{item.memory}}" class="memory-box"><text class="memory-label">记忆提示</text><text class="memory-text">{{item.memory}}</text></view>
            <text class="status-note">回忆得怎么样？自评可跳过。</text>
            <view class="rating-row"><button class="{{item.rating === 'none' ? 'selected' : ''}}" data-index="{{index}}" data-value="none" bindtap="onRate">不会</button><button class="{{item.rating === 'fuzzy' ? 'selected' : ''}}" data-index="{{index}}" data-value="fuzzy" bindtap="onRate">有点模糊</button><button class="{{item.rating === 'remembered' ? 'selected' : ''}}" data-index="{{index}}" data-value="remembered" bindtap="onRate">记住了</button></view>
            <view wx:if="{{item.source}}" class="source-box"><text class="source-label">资料口径</text><text class="source-text">{{item.source}}</text></view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
  <view class="learn-footer">
    <view wx:if="{{groupComplete}}" class="finish-panel">
      <text class="finish-text">本组 {{total}} 个知识点已学习 · {{groupAction.type === 'practice' ? '建议完成 5 道巩固练习' : '下一步已安排'}}</text>
      <button class="primary-button" bindtap="onAction">{{groupAction.type === 'practice' ? '开始巩固' : groupAction.label}}</button>
      <view class="finish-links"><button class="text-button" bindtap="onRestart">重新学习</button><button class="text-button" bindtap="onBackGroups">稍后再练</button></view>
    </view>
    <block wx:else>
      <text class="swipe-hint">已学习 {{groupAction.learnedCount}} / {{total}} · 查看解析后继续</text>
      <view class="nav-actions"><button class="secondary-button" disabled="{{currentIndex === 0}}" bindtap="onPrevious">上一条</button><button class="primary-button" bindtap="onNext">{{learningItems[currentIndex].revealed ? currentIndex === total - 1 ? '完成本组学习' : '完成并继续' : '查看解析'}}</button></view>
    </block>
  </view>
</view>
<view wx:elif="{{error}}" class="page"><ui-state title="暂时找不到这组内容" description="返回学习页，重新选择一个分类。" action="返回学习" bind:action="onGoStudy" /></view>
