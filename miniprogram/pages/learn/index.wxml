<view class="learn-page" wx:if="{{topic}}">
  <view class="learn-header"><view class="learn-position"><text class="position-current">{{currentIndex + 1}}</text><text class="position-total"> / {{total}}</text></view><progress percent="{{(currentIndex + 1) / total * 100}}" stroke-width="6" activeColor="#4D785B" backgroundColor="#E8EAE4" border-radius="3" aria-label="当前 {{currentIndex + 1}}，共 {{total}} 条" /></view>
  <swiper class="learning-swiper {{saving || confirming ? 'is-busy' : ''}}" current="{{swiperCurrent}}" bindchange="onSwiperChange" duration="260">
    <swiper-item wx:for="{{learningItems}}" wx:key="id">
      <scroll-view class="card-scroll" scroll-y>
        <view class="learning-card {{item.revealed ? 'is-revealed' : 'is-prompt'}}">
          <view class="card-meta">
            <view class="card-tags"><text class="card-state {{item.learned ? 'is-learned' : ''}}">{{item.degreeLabel}}</text><text class="card-index">{{item.learned ? '已学习' : '未学习'}}</text></view>
            <button class="familiar-button" disabled="{{saving || confirming}}" data-index="{{index}}" bindtap="onFamiliar" hover-class="button-pressed" aria-label="{{item.excluded ? '取消熟知' : '标记熟知'}}"><image src="/assets/learning/{{item.excluded ? 'star-active' : 'star'}}.svg" aria-hidden="true" /><text>{{item.excluded ? '已熟知' : '熟知'}}</text></button>
          </view>
          <text class="knowledge-title">{{item.title}}</text>
          <math-formula wx:if="{{item.revealed && item.formulaLines && item.formulaLines.length}}" lines="{{item.formulaLines}}" note="{{item.formulaNote}}" spoken="{{item.summary}}" size="{{item.formulaSize}}" />
          <button wx:if="{{!item.revealed}}" class="reveal-button" hover-class="button-pressed" data-index="{{index}}" bindtap="onReveal"><image class="learning-icon" src="/assets/learning/fuzzy.svg" aria-hidden="true" />点击查看{{item.formulaLines && item.formulaLines.length ? '解析' : '释义'}}</button>
          <view wx:if="{{item.revealed}}" class="answer-area">
            <view class="definition-panel"><view class="learning-label"><image class="learning-icon small" src="/assets/learning/book.svg" aria-hidden="true" /><text>释义</text></view><text class="definition-text">{{item.summary}}</text></view>
            <block wx:if="{{item.hasSeparateDetail}}">
              <view class="answer-section-divider"></view>
              <text class="answer-label">解析</text>
              <text class="answer-detail">{{item.detail}}</text>
            </block>
            <view wx:if="{{item.memory}}" class="memory-box"><text class="memory-label">记忆提示</text><text class="memory-text">{{item.memory}}</text></view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
  <view class="learn-footer">
    <view wx:if="{{showCompletion}}" class="finish-panel">
      <text class="finish-text">本组 {{total}} 个知识点已学习</text>
      <button wx:if="{{groupAction.type === 'next'}}" class="primary-button" bindtap="onAction">学习下一组</button>
      <button wx:else class="primary-button" bindtap="onBackGroups">返回学习范围</button>
      <view class="finish-links"><button class="text-button" bindtap="onRestart">回看本组</button><button class="text-button" bindtap="onPracticeSet">自由练习</button></view>
    </view>
    <block wx:else>
      <view class="degree-actions">
        <button class="degree-button" disabled="{{saving || confirming || learningItems[currentIndex].excluded}}" hover-class="button-pressed" data-index="{{currentIndex}}" aria-label="陌生，基本想不起来" data-value="none" bindtap="onRate"><image class="degree-icon" src="/assets/learning/none.svg" aria-hidden="true" /><text>陌生</text></button>
        <button class="degree-button" disabled="{{saving || confirming || learningItems[currentIndex].excluded}}" hover-class="button-pressed" data-index="{{currentIndex}}" aria-label="了解，有印象但回忆不完整或费力" data-value="fuzzy" bindtap="onRate"><image class="degree-icon" src="/assets/learning/fuzzy.svg" aria-hidden="true" /><text>了解</text></button>
        <button class="degree-button" disabled="{{saving || confirming || learningItems[currentIndex].excluded}}" hover-class="button-pressed" data-index="{{currentIndex}}" aria-label="掌握，能顺利回忆主要内容" data-value="remembered" bindtap="onRate"><image class="degree-icon" src="/assets/learning/remembered.svg" aria-hidden="true" /><text>掌握</text></button>
      </view>
      <button wx:if="{{learningItems[currentIndex].excluded}}" class="text-button familiar-continue" bindtap="advanceAfterRating">继续学习</button>
    </block>
  </view>
</view>
<view wx:elif="{{error}}" class="page"><ui-state title="暂时找不到这组内容" description="返回学习页，重新选择一个分类。" action="返回学习" bind:action="onGoStudy" /></view>
