.sync-detail { padding:36rpx; }
.sync-symbol { display:block; width:64rpx; height:64rpx; margin-bottom:24rpx; }
.sync-facts { border-top:1rpx solid var(--color-border); margin-top:32rpx; padding-top:8rpx; }
.sync-facts > view { display:flex; justify-content:space-between; gap:24rpx; padding:20rpx 0; font-size:25rpx; color:var(--color-text-secondary); }
.sync-facts > view > text:last-child { text-align:right; color:var(--color-text); }
