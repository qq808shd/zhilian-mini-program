.detail-page {
  padding-top: 22rpx;
}

.detail-header {
  padding: 14rpx 6rpx 30rpx;
}

.detail-category {
  display: block;
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 650;
}

.detail-title {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text);
  font-size: 48rpx;
  font-weight: 730;
  line-height: 1.35;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.detail-tag {
  margin: 0 10rpx 8rpx 0;
  padding: 7rpx 13rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface-muted);
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.memory-card {
  padding: 30rpx;
  border-color: #cfdcf2;
  background: var(--color-primary-soft);
}

.memory-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.memory-label {
  color: #52698d;
  font-size: 23rpx;
  font-weight: 650;
}

.memory-mark {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #ffffff;
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.memory-prompt {
  display: block;
  margin-top: 30rpx;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 680;
  line-height: 1.5;
}

.toggle-button {
  display: flex;
  min-height: 94rpx;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.2;
  box-shadow: 0 8rpx 18rpx rgba(36, 87, 214, 0.15);
}

.answer-panel {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #cad8ef;
}

.answer-summary {
  color: #344054;
  font-size: 29rpx;
  line-height: 1.78;
}

.detail-section {
  padding: 28rpx;
}

.detail-text {
  color: #344054;
  font-size: 28rpx;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
}

.memory-tip {
  display: flex;
  padding: 26rpx 28rpx;
  border: 1rpx solid #eedfb8;
  border-radius: var(--radius-md);
  background: var(--color-warning-soft);
}

.memory-tip-line {
  width: 6rpx;
  flex: 0 0 auto;
  border-radius: 4rpx;
  background: #d39a35;
}

.memory-tip-text {
  margin-left: 20rpx;
  color: #73551f;
  font-size: 28rpx;
  line-height: 1.68;
}

.related-button {
  margin-top: 40rpx;
}

.detail-source {
  padding: 24rpx 28rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.72;
}
