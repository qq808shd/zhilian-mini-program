.detail-page {
  padding-top: 18rpx;
}

.detail-header {
  padding: 18rpx 8rpx 28rpx;
}

.detail-category {
  display: block;
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 650;
}

.detail-title {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text);
  font-size: 52rpx;
  font-weight: 730;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.detail-tag {
  margin: 0 10rpx 8rpx 0;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: var(--color-primary-soft);
  color: #4774b8;
  font-size: 22rpx;
}

.memory-card {
  padding: 30rpx;
  background: linear-gradient(145deg, #2563eb 0%, #1d4ed8 100%);
  color: #ffffff;
}

.memory-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.memory-label {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.memory-mark {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
}

.memory-prompt {
  display: block;
  margin-top: 30rpx;
  font-size: 38rpx;
  font-weight: 680;
  line-height: 1.45;
}

.toggle-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-top: 34rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: var(--color-primary-dark);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.2;
}

.toggle-button-hover {
  background: #edf5ff;
}

.answer-panel {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.answer-summary {
  font-size: 29rpx;
  line-height: 1.7;
}

.detail-section {
  padding: 28rpx;
}

.detail-text {
  color: #475569;
  font-size: 28rpx;
  line-height: 1.85;
}

.memory-tip {
  display: flex;
  padding: 26rpx 28rpx;
  border-radius: 22rpx;
  background: #fff8e8;
}

.memory-tip-line {
  width: 8rpx;
  flex: 0 0 auto;
  border-radius: 4rpx;
  background: #e6a32f;
}

.memory-tip-text {
  margin-left: 20rpx;
  color: #76551c;
  font-size: 28rpx;
  line-height: 1.65;
}

.related-button {
  margin-top: 40rpx;
}
