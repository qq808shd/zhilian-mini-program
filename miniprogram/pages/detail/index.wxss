@import "../../styles/learning-controls.wxss";

.detail-page {
  padding-top: 22rpx;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.detail-header {
  padding: 14rpx 6rpx 30rpx;
}

.detail-category {
  display: block;
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 650;
}

.detail-title {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text);
  font-size: 30px;
  font-weight: 600;
  line-height: 1.35;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.detail-tag {
  margin: 0 10rpx 8rpx 0;
  padding: 7rpx 13rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface-muted);
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.memory-card { padding: 24rpx 0; border: 0; background: transparent; box-shadow: none; }
.detail-page .toggle-button { display: flex; width: auto; gap:16rpx; min-width: 0; min-height: 88rpx; box-sizing: border-box; align-items: center; justify-content: center; margin: 16rpx auto; padding: 0 24rpx; border: 0; border-radius: 999rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 16px; font-weight: 600; line-height: 1; }
.answer-panel {
  margin-top: 26rpx;
  padding-top: 26rpx;
  background:var(--learning-tint); border-radius:28rpx; padding:28rpx;
}

.answer-summary {
  color: var(--color-text);
  font-size: 16px;
  line-height: 1.78;
}

.detail-section {
  padding: 28rpx;
}

.detail-text {
  color: var(--color-text);
  font-size: 16px;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
}

.memory-tip {
  display: flex;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--color-warning-border);
  border-radius: var(--radius-md);
  background: var(--color-warning-soft);
}

.memory-tip-line {
  width: 6rpx;
  flex: 0 0 auto;
  border-radius: 4rpx;
  background: var(--color-warning);
}

.memory-tip-text {
  margin-left: 20rpx;
  color: var(--color-warning);
  font-size: 16px;
  line-height: 1.68;
}

.related-button {
  margin-top: 40rpx;
}

.detail-topline { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.learning-status { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.degree-tag { padding: 8rpx 16rpx; border: 1rpx solid var(--color-primary-border); border-radius: var(--radius-sm); color: var(--color-primary); background: var(--color-primary-soft); }
.detail-footer { position: fixed; z-index: 2; left: 0; right: 0; bottom: 0; width: 100%; min-width: 0; box-sizing: border-box; padding: 10px 20px calc(12px + env(safe-area-inset-bottom)); background: var(--color-background); }
@media (max-height: 500px) { .detail-page { padding-bottom: 32rpx; } .detail-footer { position: static; margin-top: 32rpx; padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom)); } }
