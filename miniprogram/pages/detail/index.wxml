<view wx:if="{{item}}" class="page detail-page">
  <view class="detail-header">
    <view class="detail-topline"><text class="detail-category">{{item.moduleName}} / {{item.topicName}}</text><button class="familiar-button" disabled="{{confirming}}" bindtap="onFamiliar" hover-class="button-pressed" aria-label="{{learning.excluded ? '取消熟知' : '标记熟知'}}"><image src="/assets/learning/{{learning.excluded ? 'star-active' : 'star'}}.svg" aria-hidden="true" /><text>{{learning.excluded ? '已熟知' : '熟知'}}</text></button></view>
    <view class="learning-status"><text class="degree-tag">{{learning.degreeLabel}}</text><text>{{learning.learned ? '已学习' : '未学习'}}</text></view>
    <text class="detail-title">{{item.title}}</text>
    <view class="tag-row">
      <text wx:for="{{item.tags}}" wx:key="*this" class="detail-tag">{{item}}</text>
    </view>
  </view>

  <view class="memory-card card">
    <button class="toggle-button" hover-class="button-pressed" bindtap="onToggleAnswer">
      <image class="learning-icon" src="/assets/learning/fuzzy.svg" aria-hidden="true" />{{answerVisible ? '收起释义' : '点击查看释义'}}
    </button>
    <view wx:if="{{answerVisible}}" class="answer-panel">
      <math-formula
        wx:if="{{item.formulaLines && item.formulaLines.length}}"
        lines="{{item.formulaLines}}"
        note="{{item.formulaNote}}"
        spoken="{{item.summary}}"
        size="{{item.formulaSize}}"
      />
      <text wx:else class="answer-summary">{{item.summary}}</text>
    </view>
  </view>

  <view wx:if="{{answerVisible}}" class="section">
    <view class="section-heading">
      <text class="section-title">详细解析</text>
    </view>
    <view class="detail-section card">
      <text class="detail-text">{{item.detail}}</text>
    </view>
  </view>

  <view wx:if="{{answerVisible && item.memory}}" class="section">
    <view class="section-heading">
      <text class="section-title">记忆提示</text>
    </view>
    <view class="memory-tip">
      <view class="memory-tip-line"></view>
      <text class="memory-tip-text">{{item.memory}}</text>
    </view>
  </view>

  <button
    class="text-button related-button"
    hover-class="button-pressed"
    disabled="{{relatedCount === 0}}"
    bindtap="onStartRelatedExam"
  >
    练习关联题目 · {{relatedCount}}
  </button>
  <view class="detail-footer">
    <view class="degree-actions">
      <button class="degree-button" disabled="{{confirming || learning.excluded}}" hover-class="button-pressed" data-value="none" bindtap="onRecall"><image class="degree-icon" src="/assets/learning/none.svg" aria-hidden="true" /><text>陌生</text></button>
      <button class="degree-button" disabled="{{confirming || learning.excluded}}" hover-class="button-pressed" data-value="fuzzy" bindtap="onRecall"><image class="degree-icon" src="/assets/learning/fuzzy.svg" aria-hidden="true" /><text>了解</text></button>
      <button class="degree-button" disabled="{{confirming || learning.excluded}}" hover-class="button-pressed" data-value="remembered" bindtap="onRecall"><image class="degree-icon" src="/assets/learning/remembered.svg" aria-hidden="true" /><text>掌握</text></button>
    </view>
  </view>
</view>
