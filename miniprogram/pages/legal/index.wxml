<view class="page account-page" wx:if="{{document}}"><view class="page-header"><text class="page-title">{{document.title}}</text><text class="status-note section">版本：{{document.version}}\n生效日期：{{document.date}}</text></view><text wx:if="{{draft}}" class="draft-note">正式服务尚未开放。当前可预览协议文本，开发或体验版中的确认不代替正式服务开放后的协议确认。</text><view wx:for="{{document.sections}}" wx:key="title" class="legal-section"><text class="section-title">{{index + 1}}. {{item.title}}</text><text class="legal-body" user-select="{{true}}">{{item.body}}</text></view><button wx:if="{{privacy}}" class="secondary-button section" bindtap="onPlatformPrivacy">查看微信隐私指引</button></view>
