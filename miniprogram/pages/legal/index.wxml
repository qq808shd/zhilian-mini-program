<view class="page account-page" wx:if="{{document}}"><view class="page-header"><text class="page-title">{{document.title}}</text><text class="status-note section">版本：{{document.version}}\n生效日期：{{document.date}}</text></view><text wx:if="{{draft}}" class="draft-note">这是开发预览草稿。运营主体、联系方式等信息尚待补齐，不代表已完成上线所需的协议与隐私配置。</text><view wx:for="{{document.sections}}" wx:key="title" class="legal-section"><text class="section-title">{{index + 1}}. {{item.title}}</text><text class="legal-body" user-select="{{true}}">{{item.body}}</text></view><button wx:if="{{privacy}}" class="secondary-button section" bindtap="onPlatformPrivacy">查看微信隐私指引</button></view>
