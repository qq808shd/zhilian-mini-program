.profile-page { padding:72rpx 40rpx calc(32rpx + env(safe-area-inset-bottom)); color:var(--color-text); }
.profile-title { display:block; font-size:40rpx; font-weight:600; line-height:1.4; }
.profile-subtitle { display:block; margin-top:16rpx; font-size:26rpx; color:var(--color-text-secondary); line-height:1.5; }
button.avatar-picker { display:flex; flex-direction:column; align-items:center; justify-content:center; width:100%; min-height:184rpx; padding:12rpx 0; margin:64rpx auto 0; background:transparent; border-radius:20rpx; line-height:1.4; }
.profile-avatar { display:block; width:160rpx; height:160rpx; border-radius:50%; background:var(--color-primary-soft); }
.avatar-caption { display:block; margin-top:20rpx; font-size:28rpx; color:var(--color-primary); }
.nickname-field { margin-top:56rpx; }
.field-label { display:block; font-size:26rpx; font-weight:500; margin-bottom:16rpx; }
.nickname-input { box-sizing:border-box; width:100%; height:92rpx; padding:0 28rpx; border:1rpx solid var(--color-border); border-radius:20rpx; background:var(--color-surface); font-size:30rpx; }
.nickname-placeholder { color:var(--color-text-secondary); }
button.profile-submit { display:flex; align-items:center; justify-content:center; width:100%; height:92rpx; margin-top:56rpx; padding:0 24rpx; border-radius:20rpx; background:var(--color-primary); color:var(--color-on-primary); font-size:30rpx; font-weight:600; }
button.profile-submit[disabled] { background:var(--color-track); color:var(--color-text-secondary); }
button.profile-skip { width:auto; min-height:88rpx; margin:16rpx auto 0; padding:16rpx 24rpx; color:var(--color-text-secondary); background:transparent; font-size:26rpx; }
.profile-error,.profile-feedback,.profile-note { display:block; margin-top:16rpx; font-size:24rpx; line-height:1.5; color:var(--color-text-secondary); }
.profile-error { color:var(--color-danger); }
.profile-pressed { opacity:.8; }
@media (max-height:600px) { .profile-page { padding-top:40rpx; } button.avatar-picker { margin-top:40rpx; } .nickname-field { margin-top:32rpx; } button.profile-submit { margin-top:32rpx; } }

.nickname-input.focused { border-color:var(--color-primary); }
