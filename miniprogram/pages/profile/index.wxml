<view class="profile-page">
  <view class="profile-heading"><text class="profile-title">设置头像和昵称</text><text wx:if="{{onboarding}}" class="profile-subtitle">让学习伙伴更容易认出你</text></view>
  <form bindsubmit="onSave">
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{saving || !supported}}" hover-class="profile-pressed" aria-label="选择微信头像或其他图片"><image class="profile-avatar" src="{{avatar}}" mode="aspectFill" binderror="onAvatarError" /><text class="avatar-caption">使用微信头像 ›</text></button>
    <view class="nickname-field"><text class="field-label">昵称</text><input class="nickname-input {{nicknameFocus ? 'focused' : ''}}" name="nickname" type="nickname" value="{{nickname}}" focus="{{nicknameFocus}}" maxlength="-1" placeholder="选择微信昵称或输入昵称" placeholder-class="nickname-placeholder" bindinput="onNicknameInput" bindfocus="onNicknameFocus" bindblur="onNicknameBlur" bindnicknamereview="onNicknameReview" disabled="{{saving || !supported}}" confirm-type="done" adjust-position="true" cursor-spacing="24" /></view>
    <text class="profile-feedback">可输入表情，最多 24 个字符；若微信校验未通过，请换一个表情或昵称。</text>
    <text wx:if="{{reviewPending}}" class="profile-feedback">收起键盘后校验昵称</text>
    <text wx:if="{{!supported}}" class="profile-error">当前微信版本不支持头像昵称填写，请更新微信。</text>
    <text wx:if="{{error}}" class="profile-error">{{error}}</text>
    <button class="profile-submit" form-type="submit" loading="{{saving}}" disabled="{{saving || !supported}}" hover-class="profile-pressed">{{onboarding ? '完成' : '保存'}}</button>
  </form>
  <button class="profile-skip" bindtap="onSkip" disabled="{{saving}}">{{onboarding ? '暂不设置' : '取消'}}</button>
  <text wx:if="{{!onboarding}}" class="profile-note">头像和昵称保存到你的知练账户，供同组伙伴识别；修改后同步更新。</text>
</view>
