<view class="page account-page ux-page">
  <view class="page-header"><text class="page-title">学习记录</text><text class="page-subtitle">学习、回忆与作答，各有自己的记录。</text></view>
  <view class="card history-summary"><text class="section-title">今日完成 {{today.completed}} 个</text><text class="ux-description">新学 {{today.newCount}} 个 · 复习 {{today.reviewCount}} 个</text><button class="ux-link-row" bindtap="onToday">查看今日安排 <text>›</text></button></view>
  <view wx:if="{{activity.length}}" class="section"><view class="section-heading"><text class="section-title">近期学习与练习</text></view><text class="ux-caption">最近七日内保留的活动，最多展示 20 条</text>
    <button wx:for="{{activity}}" wx:key="id" class="history-event" data-id="{{item.knowledgeId}}" bindtap="onKnowledge"><view class="history-event-top"><text class="history-label">{{item.label}}</text><text class="ux-caption">{{item.date}}</text></view><text class="ux-body">{{item.title}}</text><text class="ux-caption">{{item.detail}}</text></button>
  </view>
  <view wx:if="{{recent.length}}" class="section"><view class="section-heading"><text class="section-title">最近浏览</text><text class="ux-caption">最近 3 组</text></view><view class="stack"><ui-entry wx:for="{{recent}}" wx:key="key" title="{{item.topicName + ' · ' + item.setName}}" description="{{item.title + ' · 第 ' + (item.currentIndex + 1) + ' / ' + item.count + ' 条'}}" data-index="{{index}}" bind:activate="onRecent" /></view></view>
  <view wx:if="{{topics.length}}" class="section"><text class="section-title">各专项积累</text><view class="stack section"><ui-entry wx:for="{{topics}}" wx:key="id" title="{{item.name}}" meta="{{item.meta}}" data-id="{{item.id}}" bind:activate="onTopic" /></view></view>
  <ui-state wx:if="{{!recent.length && !activity.length && !topics.length}}" title="从第一条开始积累" description="学过的内容会留在这里。单纯浏览不会记为已学习。" action="开始学习" bind:action="onStart" />
</view>
