<view class="page">
  <view class="module-intro" wx:if="{{module}}">
    <text class="crumb">学习 / {{module.name}}</text>
    <view class="intro-row">
      <view class="intro-symbol">{{module.symbol}}</view>
      <view class="intro-copy"><text class="page-title">{{module.name}}</text><text class="page-subtitle">{{module.description}}</text></view>
    </view>
  </view>
  <view class="section-heading"><text class="section-title">选择一个专项</text><text class="section-note">先学知识，再做练习</text></view>
  <view class="stack"><ui-entry wx:for="{{topics}}" wx:key="id" title="{{item.name}}" description="{{item.description}}" meta="{{item.meta}}" badge="{{item.badge}}" warning="{{item.activeWrongCount > 0}}" data-id="{{item.id}}" bind:activate="onOpenTopic" /></view>
</view>
