<view class="page">
  <view class="module-intro" wx:if="{{module}}">
    <text class="crumb">学习 / {{module.name}}</text>
    <view class="intro-row">
      <view class="intro-symbol">{{module.symbol}}</view>
      <view class="intro-copy"><text class="page-title">{{module.name}}</text><text class="page-subtitle">{{module.description}}</text></view>
    </view>
  </view>
  <view class="section-heading"><text class="section-title">选择学习分类</text><text class="section-note">按分类进入分组</text></view>
  <view class="topic-list">
    <button wx:for="{{topics}}" wx:key="id" class="topic-card card interactive-card" hover-class="interactive-card-hover" data-id="{{item.id}}" bindtap="onOpenTopic">
      <view class="topic-head"><text class="topic-name">{{item.name}}</text><text class="topic-arrow">›</text></view>
      <text class="topic-description">{{item.description}}</text>
      <view class="topic-meta"><text>{{item.knowledgeCount}} {{item.knowledgeUnit}}</text><text class="meta-divider"></text><text>{{item.setCount}} 组</text><text class="meta-divider"></text><text>每组最多 {{item.groupSize}} {{item.knowledgeUnit}}</text></view>
    </button>
  </view>
</view>
