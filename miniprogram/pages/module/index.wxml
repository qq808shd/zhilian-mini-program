<view class="page">
  <view class="module-intro" wx:if="{{module}}">
    <text class="crumb">学习 / {{module.name}}</text>
    <view class="intro-row"><view class="intro-symbol">{{module.symbol}}</view><view><text class="page-title">{{module.name}}</text><text class="page-subtitle">{{module.description}}</text></view></view>
  </view>
  <view class="section-heading"><text class="section-title">选择学习分类</text><text class="section-note">进入后按 20 条分组</text></view>
  <view class="topic-list">
    <button wx:for="{{topics}}" wx:key="id" class="topic-card card" style="width: 100%; min-height: 240rpx;" hover-class="topic-hover" data-id="{{item.id}}" bindtap="onOpenTopic">
      <view class="topic-head"><text class="topic-name">{{item.name}}</text><text class="topic-arrow">›</text></view>
      <text class="topic-description">{{item.description}}</text>
      <view class="topic-meta"><text>{{item.knowledgeCount}} 条内容</text><text>{{item.setCount}} 组</text><text>每组 {{item.groupSize}} 条</text></view>
    </button>
  </view>
</view>
