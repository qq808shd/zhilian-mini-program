.module-intro {
  margin-bottom: 40rpx;
}

.intro-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

.intro-symbol {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border-radius: 24rpx;
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: 42rpx;
  font-weight: 700;
}

.intro-copy {
  min-width: 0;
  flex: 1;
}

.intro-copy .page-title {
  font-size: 40rpx;
}

.intro-copy .page-subtitle {
  margin-top: 6rpx;
}
