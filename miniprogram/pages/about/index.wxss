.brand-block{text-align:center;padding:32rpx 0}.brand-mark{display:block;width:144rpx;height:144rpx;margin:0 auto 24rpx}.brand-name{display:block;font-size:46rpx;font-weight:700;color:var(--color-primary);letter-spacing:8rpx}.brand-description{display:block;margin-top:32rpx;font-size:26rpx;line-height:1.6;color:var(--color-text-secondary)}.fact-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:28rpx;min-height:104rpx;border-bottom:1rpx solid var(--color-divider);font-size:28rpx}.fact-row text:last-child{max-width:58%;text-align:right;word-break:break-all;color:var(--color-text-secondary)}
