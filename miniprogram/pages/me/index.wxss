@import "../../styles/learning-experience.wxss";
.account-page { padding:24rpx 32rpx calc(48px + 32rpx + env(safe-area-inset-bottom)); }
button.profile-header { padding:16rpx 0 40rpx; }
.account-avatar { width:112rpx; height:112rpx; }
.profile-name { font-size:36rpx; white-space:normal; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; line-height:1.4; }
.profile-caption { font-size:24rpx; }
.learning-metrics { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:0; margin-top:24rpx; padding:32rpx 16rpx; text-align:center; border-radius:24rpx; box-shadow:none; }
.metric-icon { display:block; width:32rpx; height:32rpx; margin:0 auto 16rpx; }
.learning-metrics .metric-value { font-size:40rpx; font-weight:600; line-height:1.4; }
.learning-metrics .metric-label { margin-top:8rpx; font-size:24rpx; line-height:1.5; white-space:nowrap; }
.metrics-note { display:block; margin-top:16rpx; color:var(--color-text-secondary); font-size:24rpx; line-height:1.6; }
.list-card { margin-top:32rpx; border-radius:24rpx; box-shadow:none; }
button.contact-row { display:flex; align-items:center; gap:16rpx; width:100%; min-width:0; min-height:112rpx; margin-top:32rpx; padding:24rpx; border-radius:24rpx; background:var(--color-surface); border:1rpx solid var(--color-border); text-align:left; color:var(--color-text); }
.contact-icon { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; flex-shrink:0; }
.contact-copy { flex:1; min-width:0; }
.contact-title { display:block; font-size:28rpx; }
.contact-email { display:block; margin-top:8rpx; font-size:24rpx; color:var(--color-text-secondary); word-break:break-all; }
.contact-action { font-size:24rpx; color:var(--color-primary); }
.filing-footer { margin-top:24rpx; }
@media (max-width:350px) { .learning-metrics .metric-value { font-size:36rpx; } .learning-metrics .metric-label { font-size:22rpx; } }
