<view class="group-page"><text class="g-title">我的契约历史</text><text class="g-sub g-gap-sm">每一次认真开始，都值得留下。</text><text wx:if="{{error}}" class="g-error">{{error}}</text><button wx:if="{{error}}" class="g-button g-secondary" bindtap="load">重新读取</button><text wx:if="{{busy}}" class="g-sub g-gap">正在读取契约历史…</text><view wx:if="{{loaded && !items.length}}" class="g-empty"><image class="g-illustration" src="/assets/groups/companions.png" mode="aspectFit" /><text class="g-heading">还没有已结束的契约</text><text class="g-sub">结束的契约会保存在这里，新的同行仍可继续。</text><button class="g-button g-secondary" bindtap="onGroup">回到学习小组</button></view><view wx:for="{{items}}" wx:key="id" class="g-card g-gap"><view class="g-between"><text class="g-heading">{{item.name}}</text><text class="g-pill g-neutral history-state">{{item.endText}}</text></view><text class="g-sub g-gap-sm">{{item.joinedDate}} 至 {{item.exitedDate}}</text><view class="g-stats g-gap"><view><text class="g-stat-value">{{item.days}}</text><text class="g-small">参与天数</text></view><view><text class="g-stat-value">{{item.fulfilled}}</text><text class="g-small">履约天数</text></view><view><text class="g-stat-value">{{item.longestStreak}}</text><text class="g-small">最长连续守约</text></view></view></view><button wx:if="{{nextCursor}}" class="g-button g-secondary g-gap" bindtap="load" loading="{{busy}}" disabled="{{busy}}">查看更多契约</button></view>
