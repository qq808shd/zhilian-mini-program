.plan-page .page-title { font-size:38rpx; }
.plan-page .page-header { margin-bottom:24rpx; }
.settings-card { margin-bottom:24rpx; padding:28rpx; }
.choice-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; margin-top:16rpx; }
.choice { display:flex; align-items:center; justify-content:center; width:100%!important; min-width:0; min-height:88rpx; padding:16rpx 12rpx; margin:0; border:1rpx solid var(--color-border); border-radius:var(--radius-sm); background:var(--color-background); font-size:27rpx; line-height:1.5; color:var(--color-text-secondary); }
.choice.selected { border-color:var(--color-primary); background:var(--color-primary-soft); color:var(--color-primary-dark); font-weight:650; }
.field-title { display:block; margin-top:24rpx; font-size:28rpx; font-weight:600; }
.scope-note { display:block; margin-top:20rpx; }
.quantity-card { background:var(--color-primary-soft); border-color:var(--color-primary-border); }
.quantity-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-height:64rpx; }
.quantity-value { display:flex; align-items:baseline; gap:8rpx; color:var(--color-primary-dark); font-size:25rpx; white-space:nowrap; }
.quantity-number { font-size:48rpx; font-weight:650; line-height:1.2; font-variant-numeric:tabular-nums; }
.all-label { font-size:23rpx; }
.quantity-slider { margin:12rpx 0 0; padding:12rpx 0; }
.slider-labels { display:flex; justify-content:space-between; color:var(--color-text-secondary); font-size:24rpx; }
.quantity-note { display:block; margin-top:20rpx; }
.plan-note, .effective-note { display:block; font-size:24rpx; line-height:1.6; color:var(--color-text-secondary); }
.effective-note { margin:8rpx 0 24rpx; }

.plan-page { padding-bottom:calc(160rpx + env(safe-area-inset-bottom)); }
.save-footer { position:fixed; z-index:10; left:0; right:0; bottom:0; padding:16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); background:var(--color-background); border-top:1rpx solid var(--color-border); }
