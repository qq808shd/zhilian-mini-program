.plan-page .page-title { font-size:38rpx; }
.settings-card { margin-bottom:24rpx; padding:28rpx; }
.choice-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; margin-top:20rpx; }
button.choice { display:flex; align-items:center; justify-content:center; width:100%!important; min-width:0; min-height:92rpx; padding:16rpx 12rpx; margin:0; border:1rpx solid var(--color-border); background:var(--color-background); font-size:27rpx; line-height:1.5; color:var(--color-text-secondary); }
button.choice.selected { border-color:var(--color-primary); background:var(--color-primary-soft); color:var(--color-primary-dark); font-weight:650; }
.field-title { display:block; margin-top:28rpx; font-size:28rpx; font-weight:600; }
.batch-list { display:flex; flex-direction:column; gap:12rpx; margin-top:16rpx; }
.count-options { display:flex; gap:12rpx; margin:20rpx 0; }
.count-options .choice { flex:1; }
.scope-note, .effective-note { display:block; margin-top:20rpx; }
.effective-note { margin:24rpx 0; font-size:25rpx; line-height:1.7; color:var(--color-text-secondary); }
