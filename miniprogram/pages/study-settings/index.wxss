@import "../../styles/learning-theme.wxss";
.plan-page { padding:12px 20px calc(88px + env(safe-area-inset-bottom)); }
.settings-scope { display:flex; align-items:center; gap:14px; padding:12px 20px; border-radius:var(--learning-radius); background:var(--color-primary-soft); }
.settings-art { width:112rpx; height:112rpx; flex-shrink:0; border-radius:24rpx; }
.scope-label { display:block; color:var(--color-text-secondary); font-size:13px; }
.scope-name { display:block; margin-top:12rpx; font-size:22px; font-weight:600; }
.quantity-card { margin-top:12px; padding:20px; border:0; border-radius:var(--learning-radius); box-shadow:var(--learning-shadow); }
.quantity-heading { display:flex; align-items:center; justify-content:center; gap:20rpx; font-size:16px; font-weight:500; }
.quantity-value { display:flex; align-items:baseline; justify-content:center; gap:20rpx; margin:40rpx 0 32rpx; font-size:28rpx; }
.quantity-number { font-size:88rpx; font-weight:600; line-height:1.2; font-variant-numeric:tabular-nums; }
.quantity-control { display:flex; align-items:center; gap:8rpx; }
.quantity-slider { flex:1; min-width:0; margin:0 8rpx; padding:12rpx 0; }
.plan-page .step-button { display:flex; align-items:center; justify-content:center; width:88rpx; min-width:0; height:88rpx; padding:0; flex-shrink:0; border-radius:50%; background:var(--learning-green); }
.step-button[disabled] { opacity:.4; }
.slider-labels { display:flex; justify-content:space-between; padding:12rpx 22rpx 0; color:var(--color-text-secondary); font-size:13px; }
.quantity-note { display:block; margin-top:32rpx; text-align:center; color:var(--color-text-secondary); font-size:13px; }
.plan-page .reset-entry { display:flex; align-items:center; gap:20rpx; width:100%; min-width:0; min-height:68px; margin-top:12px; padding:12px; border-radius:var(--learning-radius); background:var(--color-surface); box-shadow:var(--learning-shadow); text-align:left; color:var(--color-text); font-size:16px; line-height:1.5; }
.reset-icon { display:flex; justify-content:center; align-items:center; width:64rpx; height:64rpx; border-radius:20rpx; background:#faf2ec; flex-shrink:0; }
.reset-copy { flex:1; min-width:0; }
.reset-note { display:block; margin-top:6rpx; color:var(--color-text-secondary); font-size:13px; }
.save-footer { position:fixed; z-index:10; left:0; right:0; bottom:0; padding:8px 20px calc(12px + env(safe-area-inset-bottom)); background:var(--color-background); }
.save-button { gap:16rpx; min-height:96rpx; border-radius:16px; font-size:16px; font-weight:500; }

.plan-page { padding-left:32rpx; padding-right:32rpx; }
.quantity-note { font-size:24rpx; text-align:left; line-height:1.6; }
.quantity-card { padding:32rpx; border-radius:24rpx; }
