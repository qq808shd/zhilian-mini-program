@import "../../styles/learning-controls.wxss";
.daily-page { display:flex; flex-direction:column; height:100vh; min-height:0; padding:12px var(--learning-gutter) calc(16px + env(safe-area-inset-bottom)); overflow:hidden; }
.daily-heading { flex-shrink:0; height:44px; margin-bottom:16px; }
.daily-position { display:flex; justify-content:center; align-items:baseline; gap:6px; margin-bottom:12px; font-variant-numeric:tabular-nums; }
.position-current { font-size:18px; font-weight:600; }
.position-total { font-size:14px; color:var(--color-text-secondary); }
.daily-swiper { flex:1; min-height:0; width:100%; }
.daily-scroll { height:100%; }
.is-busy { pointer-events:none; }
.daily-card { min-height:100%; padding:12px 20px 28px; border:1px solid #f0efea; border-radius:var(--learning-radius); background:var(--color-surface); box-shadow:var(--learning-shadow); }
.daily-meta { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:44px; }
.daily-status { color:var(--color-text-secondary); font-size:13px; line-height:1.5; }
.daily-title { display:block; margin:56px 0 44px; font-size:30px; font-weight:600; line-height:1.45; color:var(--color-text); text-align:center; }
.definition-panel { padding:16px; background:var(--learning-tint); border-radius:16px; }
.daily-body { display:block; white-space:pre-wrap; font-size:16px; line-height:28px; margin:12px 0 20px; }
.definition-panel .daily-body { margin:12px 0 0; }
.answer-label { display:block; margin-top:24px; font-size:13px; font-weight:500; color:var(--color-primary); }
.daily-card .inset-note { padding:16px; margin-top:20px; background:var(--learning-amber-soft); border-radius:16px; }
.inset-note .answer-label { margin-top:0; color:var(--learning-amber); }
.inset-note .daily-body { margin-bottom:0; }
.reveal-area { display:flex; justify-content:center; padding:12px 0 48px; }
.daily-footer { flex-shrink:0; padding-top:16px; }
.completion-card { display:flex; align-items:center; flex-direction:column; padding:80px 0 24px; text-align:center; }
.completion-mark { width:48px; height:48px; margin-bottom:24px; }
.completion-card .page-title { font-size:22px; }
.completion-card .primary-button { margin-top:32px; max-width:240px; border-radius:16px; }
@media (max-height:500px) { .daily-page { min-height:460px; height:100vh; } }
