<view class="page daily-page">
  <block wx:if="{{task}}">
    <view class="daily-heading"><view class="daily-position"><text class="position-current">{{currentIndex + 1}}</text><text class="position-total"> / {{cards.length}}</text></view><progress percent="{{positionProgress}}" stroke-width="6" activeColor="#4D785B" backgroundColor="#E8EAE4" border-radius="3" aria-label="当前 {{currentIndex + 1}}，共 {{cards.length}} 条" /></view>
    <swiper class="daily-swiper {{saving || confirming ? 'is-busy' : ''}}" current="{{currentIndex}}" bindchange="onSwiperChange" duration="220">
      <swiper-item wx:for="{{cards}}" wx:key="id">
        <scroll-view class="daily-scroll" scroll-y>
          <view wx:if="{{index >= currentIndex - 1 && index <= currentIndex + 1}}" class="card daily-card">
            <view class="daily-meta"><text class="daily-status">{{item.current.degreeLabel}} · {{item.current.learned ? '已学习' : '未学习'}}</text><button class="familiar-button" disabled="{{saving || confirming}}" data-task-id="{{item.id}}" bindtap="onFamiliar" hover-class="button-pressed" aria-label="{{item.current.excluded ? '取消熟知' : '标记熟知'}}"><image src="/assets/learning/{{item.current.excluded ? 'star-active' : 'star'}}.svg" aria-hidden="true" /><text>{{item.current.excluded ? '已熟知' : '熟知'}}</text></button></view>
            <text class="daily-title">{{item.knowledge.title}}</text>
            <block wx:if="{{item.revealed}}">
              <math-formula wx:if="{{item.knowledge.formulaLines && item.knowledge.formulaLines.length}}" lines="{{item.knowledge.formulaLines}}" note="{{item.knowledge.formulaNote}}" spoken="{{item.knowledge.summary}}" size="{{item.knowledge.formulaSize}}" />
              <view class="definition-panel"><view class="learning-label"><image class="learning-icon small" src="/assets/learning/book.svg" aria-hidden="true" /><text>{{item.knowledge.formulaLines && item.knowledge.formulaLines.length ? '说明' : '释义'}}</text></view><text class="daily-body">{{item.knowledge.summary}}</text></view>
              <block wx:if="{{item.knowledge.detail && item.knowledge.detail !== item.knowledge.summary}}"><text class="answer-label">解析</text><text class="daily-body">{{item.knowledge.detail}}</text></block>
              <view wx:if="{{item.knowledge.memory}}" class="inset-note"><text class="answer-label">记忆提示</text><text class="daily-body">{{item.knowledge.memory}}</text></view>
            </block>
            <view wx:else class="reveal-area"><button class="reveal-button" hover-class="button-pressed" data-task-id="{{item.id}}" bindtap="onReveal"><image class="learning-icon" src="/assets/learning/fuzzy.svg" aria-hidden="true" /><text>点击查看{{item.knowledge.formulaLines && item.knowledge.formulaLines.length ? '解析' : '释义'}}</text></button></view>
          </view>
        </scroll-view>
      </swiper-item>
    </swiper>
    <view class="daily-footer">
      <view class="degree-actions">
        <button class="degree-button" disabled="{{saving || confirming || current.excluded}}" hover-class="button-pressed" data-task-id="{{task.id}}" data-value="none" bindtap="onRate"><image class="degree-icon" src="/assets/learning/none.svg" aria-hidden="true" /><text>陌生</text></button>
        <button class="degree-button" disabled="{{saving || confirming || current.excluded}}" hover-class="button-pressed" data-task-id="{{task.id}}" data-value="fuzzy" bindtap="onRate"><image class="degree-icon" src="/assets/learning/fuzzy.svg" aria-hidden="true" /><text>了解</text></button>
        <button class="degree-button" disabled="{{saving || confirming || current.excluded}}" hover-class="button-pressed" data-task-id="{{task.id}}" data-value="remembered" bindtap="onRate"><image class="degree-icon" src="/assets/learning/remembered.svg" aria-hidden="true" /><text>掌握</text></button>
      </view>
    </view>
  </block>
  <view wx:else class="completion-card"><image class="completion-mark" src="/assets/learning/remembered.svg" aria-hidden="true" /><text class="page-title">{{daily.total ? '本轮已完成' : mode === 'review' ? '暂无待复习' : daily.summary.unlearnedCount ? '今日新学已完成' : '这个分类已学完'}}</text><text class="page-subtitle">{{mode === 'review' ? '今日复习 ' + daily.completed + ' 个' : '今日新学 ' + daily.summary.newCount + ' 个'}}</text><button class="primary-button" hover-class="button-pressed" bindtap="onHome">完成</button></view>
</view>
