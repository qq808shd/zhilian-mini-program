<view class="page study-page">
  <view class="scope-card" wx:if="{{topic}}">
    <view class="scope-main">
      <view class="scope-copy">
        <view class="learning-label"><image class="learning-icon small" src="/assets/learning/book.svg" aria-hidden="true" /><text>当前学习</text></view>
        <view class="scope-top"><button class="scope-title" hover-class="button-pressed" bindtap="onFreeStudy" aria-label="浏览当前学习内容">{{topic.name}}</button><button class="scope-switch" hover-class="button-pressed" bindtap="onScope"><text>切换</text><image class="learning-icon small" src="/assets/learning/swap.svg" aria-hidden="true" /></button></view>
        <view class="scope-progress-copy"><text>已学 <text class="scope-number">{{scope.learnedCount}}</text> / {{scope.total}}</text></view>
        <view class="scope-meter"><progress-meter value="{{scope.progress || 0}}" label="已学习进度" /></view>
      </view>
      <image class="scope-art" src="/assets/learning/book-sprout.jpg" mode="aspectFit" aria-hidden="true" />
    </view>
    <view class="degree-row" aria-label="已学内容的学习程度">
      <button class="degree-stat" data-value="none" hover-class="button-pressed" bindtap="onDegree"><image src="/assets/learning/none.svg" aria-hidden="true" /><text>陌生</text><text class="degree-count">{{scope.strangerCount || 0}}</text></button>
      <button class="degree-stat" data-value="fuzzy" hover-class="button-pressed" bindtap="onDegree"><image src="/assets/learning/fuzzy.svg" aria-hidden="true" /><text>了解</text><text class="degree-count">{{scope.understoodCount || 0}}</text></button>
      <button class="degree-stat" data-value="remembered" hover-class="button-pressed" bindtap="onDegree"><image src="/assets/learning/remembered.svg" aria-hidden="true" /><text>掌握</text><text class="degree-count">{{scope.masteredCount || 0}}</text></button>
      <button class="degree-stat" data-value="known" hover-class="button-pressed" bindtap="onDegree"><image src="/assets/learning/known.svg" aria-hidden="true" /><text>熟知</text><text class="degree-count">{{scope.familiarCount || 0}}</text></button>
    </view>
  </view>
  <view class="card study-actions">
    <view class="section-heading"><text class="section-title">今日学习</text><button class="study-settings" hover-class="button-pressed" bindtap="onSettings" aria-label="学习设置"><image class="learning-icon" src="/assets/learning/settings.svg" aria-hidden="true" /></button></view>
    <view class="study-buttons">
      <button class="study-action new-action" hover-class="button-pressed" bindtap="onToday"><image src="/assets/learning/new.svg" aria-hidden="true" /><view class="action-copy"><text>新学</text><text class="action-count">{{daily.fresh || 0}}</text></view></button>
      <button class="study-action review-action" hover-class="button-pressed" bindtap="onReview"><image src="/assets/learning/review.svg" aria-hidden="true" /><view class="action-copy"><text>复习</text><text class="action-count">{{daily.due || 0}}</text></view></button>
    </view>
  </view>
</view>
