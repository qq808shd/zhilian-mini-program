<view class="page study-page">
  <view class="home-heading"><text class="kicker">知练 · 每一次积累都有意义</text><text class="page-title">{{greeting}}，慢慢学，稳稳记。</text></view>
  <view class="continue-card">
    <view class="continue-top"><text class="pill">今日学习</text><button class="plan-settings" bindtap="onSettings" hover-class="button-pressed">学习设置 ›</button></view>
    <text class="continue-title">{{daily.subject}}</text>
    <text class="continue-copy">{{daily.goal ? '每天新学 ' + daily.goal + ' 个 · 先复习，再学新知' : '继续完成已开始的学习安排'}}</text>
    <view class="daily-counts"><view><text class="count-number">{{daily.due || 0}}</text><text>待复习</text></view><view><text class="count-number">{{daily.fresh || 0}}</text><text>待新学</text></view><view><text class="count-number">{{daily.practice || 0}}</text><text>待练习</text></view></view>
    <view class="continue-progress"><progress-meter value="{{daily.progress || 0}}" label="今日学习进度" /><text>{{daily.remaining ? '已完成 ' + daily.completed + ' 项 · 预计还需 ' + daily.minutes + ' 分钟' : daily.total ? '今天的安排已完成' : '当前分类暂无新学或到期内容，可调整学习设置'}}</text></view>
    <text wx:if="{{daily.settingsPending}}" class="pending-note">明日起：{{daily.nextSubject}} · 每天新学 {{daily.nextGoal}} 个</text>
    <button class="primary-button" hover-class="button-pressed" bindtap="onToday">{{daily.button || '开始今日学习'}} →</button>
  </view>
  <view class="card free-card">
    <view class="free-heading"><text class="section-title">自由学习</text><text class="section-note">按自己的节奏</text></view>
    <text class="page-subtitle">言语、数量关系、资料分析、常识理论</text>
    <button class="secondary-button" bindtap="onFreeStudy" hover-class="button-pressed">开始学习 →</button>
  </view>
</view>
