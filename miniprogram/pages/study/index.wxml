<view class="page study-page">
  <view class="study-hero">
    <text class="eyebrow">个人学习库</text>
    <text class="page-title hero-title">选择一个模块，开始学习</text>
    <text class="page-subtitle hero-subtitle">按模块、分类和分组循序学习，每组完成后也可以随时重学。</text>
    <view class="flow-note">
      <view class="flow-step"><text class="flow-number">1</text><text>选模块</text></view>
      <text class="flow-line"></text>
      <view class="flow-step"><text class="flow-number">2</text><text>选分类与分组</text></view>
      <text class="flow-line"></text>
      <view class="flow-step"><text class="flow-number">3</text><text>逐条学习</text></view>
    </view>
  </view>

  <view class="section-heading">
    <text class="section-title">学习模块</text>
    <text class="section-note">{{moduleCards.length}} 个模块</text>
  </view>

  <view class="module-list">
    <button wx:for="{{moduleCards}}" wx:key="id" class="module-card card interactive-card" hover-class="interactive-card-hover" data-id="{{item.id}}" bindtap="onOpenModule">
      <view class="module-symbol"><text>{{item.symbol}}</text></view>
      <view class="module-content">
        <view class="module-title-row"><text class="module-name">{{item.name}}</text><text class="module-arrow">›</text></view>
        <text class="module-description">{{item.description}}</text>
        <view class="module-metrics">
          <text>{{item.topicCount}} 个分类</text>
          <text class="metric-dot"></text>
          <text>{{item.knowledgeCount}} 条知识</text>
        </view>
      </view>
    </button>
  </view>
</view>
