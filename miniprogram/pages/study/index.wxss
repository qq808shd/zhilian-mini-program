.home-heading { padding: 8rpx 0 24rpx; }
.home-heading .page-title { font-size: 37rpx; margin-top: 12rpx; line-height: 1.4; }
.continue-card { padding: 24rpx 28rpx 28rpx; border: 1rpx solid var(--color-primary-border); border-radius: var(--radius-lg); background: var(--color-primary-soft); }
.continue-top, .free-heading { display:flex; align-items:center; justify-content:space-between; }
.continue-top .pill { padding-left:0; }
button.plan-settings { width:auto!important; min-height:88rpx; padding:0 4rpx 0 24rpx; background:transparent; color:var(--color-primary); font-size:25rpx; }
.continue-title { display:block; margin-top:4rpx; font-size:36rpx; font-weight:650; line-height:1.5; }
.continue-copy { display:block; margin:8rpx 0 20rpx; color:var(--color-text-secondary); font-size:25rpx; line-height:1.6; }
.daily-counts { display:flex; margin:20rpx 0; color:var(--color-primary-dark); font-size:24rpx; }
.daily-counts view { flex:1; text-align:center; border-right:1rpx solid var(--color-primary-border); }
.daily-counts view:last-child { border:0; }
.count-number { display:block; font-size:40rpx; font-weight:650; margin-bottom:4rpx; }
.continue-progress { margin-bottom:20rpx; }
.continue-progress text, .pending-note { display:block; margin-top:8rpx; color:var(--color-text-secondary); font-size:23rpx; line-height:1.5; }
.pending-note { margin-bottom:16rpx; }
.free-card { margin-top:24rpx; padding:28rpx; }
.free-card .page-subtitle { font-size:25rpx; margin:12rpx 0 24rpx; }
