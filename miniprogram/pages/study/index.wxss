@import "../../styles/learning-theme.wxss";
.study-page { padding:12px var(--learning-gutter) calc(48px + 20px + env(safe-area-inset-bottom)); }
.scope-card { overflow:hidden; padding:20px 12px 12px; background:var(--color-primary-soft); border-radius:var(--learning-radius); }
.scope-main { position:relative; padding:0 8px 20px; }
.scope-copy { min-width:0; }
.scope-art { position:absolute; right:0; top:46px; width:74px; height:74px; border-radius:16px; pointer-events:none; }
.scope-top { display:flex; align-items:center; gap:12px; margin:12px 80px 16px 0; flex-wrap:nowrap; }
.study-page .scope-title { flex:0 1 auto; width:auto; min-width:0; max-width:100%; min-height:44px; padding:4px 0; margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; background:transparent; text-align:left; font-size:22px; font-weight:600; line-height:36px; color:var(--color-text); }
.study-page .scope-switch { display:flex; flex:0 0 auto; align-items:center; justify-content:center; gap:6px; width:auto; min-width:44px; min-height:44px; padding:0; margin:0; background:transparent; border:0; border-radius:0; color:var(--color-text); font-size:13px; font-weight:400; }
.scope-progress-copy { display:flex; align-items:baseline; gap:8px; margin:0 86px 8px 0; font-size:14px; color:var(--color-text); white-space:nowrap; }
.scope-number { font-weight:500; font-size:16px; font-variant-numeric:tabular-nums; }
.scope-meter { margin-right:86px; }
.degree-row { display:flex; padding:12px 0; border-radius:16px; background:rgba(255,255,255,.85); }
.study-page .degree-stat { flex:1 1 0%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; width:0; min-width:0; min-height:76px; margin:0; padding:0 4px; border-radius:0; background:transparent; color:var(--color-text); font-size:13px; font-weight:400; line-height:1.3; }
.degree-stat + .degree-stat { border-left:1px solid var(--color-divider); }
.degree-stat image { width:22px; height:22px; }
.degree-count { color:var(--color-text); font-size:18px; font-weight:500; font-variant-numeric:tabular-nums; }
.study-actions { margin-top:16px; padding:4px 16px 16px; border:0; border-radius:var(--learning-radius); box-shadow:var(--learning-shadow); }
.study-actions .section-heading { margin:0 0 8px; min-height:44px; }
.study-actions .section-title { font-size:18px; font-weight:500; }
.study-page .study-settings { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:44px; min-width:0; height:44px; padding:0; margin-right:-8px; background:transparent; }
.study-buttons { display:flex; gap:var(--learning-gap); }
.study-buttons .study-action { display:flex; flex:1 1 0%; flex-direction:column; align-items:center; justify-content:center; gap:10px; width:0; min-width:0; min-height:116px; padding:14px 8px; border:0; border-radius:16px; background:var(--learning-tint); color:var(--color-text); font-size:16px; font-weight:400; line-height:1.3; }
.study-action image { flex-shrink:0; width:32px; height:32px; }
.study-buttons .review-action { background:var(--learning-blue-soft); }
.action-copy { display:flex; flex-direction:column; gap:4px; text-align:center; }
.action-count { font-size:22px; font-weight:500; font-variant-numeric:tabular-nums; }
@media (max-width:350px) { .scope-art { width:62px; height:62px; } .scope-top { margin-right:64px; gap:8px; } .scope-title { font-size:20px; } }
