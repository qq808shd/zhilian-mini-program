.home-heading { padding: 12rpx 0 32rpx; }
.home-heading .page-title { font-size: 39rpx; margin-top: 16rpx; line-height: 1.4; }
.continue-card { padding: 32rpx; border: 1rpx solid var(--color-primary-border); border-radius: var(--radius-lg); background: var(--color-primary-soft); }
.continue-top { display: flex; align-items: center; justify-content: space-between; }
.continue-top .pill { padding-left: 0; }
.continue-decoration { color: var(--color-primary); font-family: Georgia, 'Songti SC', serif; font-size: 25rpx; letter-spacing: 4rpx; }
.continue-title { display: block; margin-top: 24rpx; font-size: 40rpx; font-weight: 650; line-height: 1.4; }
.continue-copy { display: block; margin: 14rpx 0 28rpx; color: var(--color-text-secondary); font-size: 27rpx; line-height: 1.7; }
.continue-progress { margin-bottom: 28rpx; }
.continue-progress text { display: block; margin-top: 6rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.cta-arrow { margin-left: 24rpx; }
.quick-actions { display: flex; margin-top: 24rpx; padding: 8rpx 0; }
.quick-actions button { display: block; flex: 1; width: 50% !important; min-width: 0; min-height: 116rpx; padding: 12rpx 20rpx; background: transparent; text-align: left; }
.quick-actions button:first-child { padding-left: 4rpx; border-right: 1rpx solid var(--color-border); }
.quick-title { display: block; color: var(--color-text); font-size: 30rpx; font-weight: 650; }
.quick-title text { color: var(--color-primary); margin-left: 8rpx; }
.quick-note { display: block; margin-top: 12rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.6; }
.weak-note { display: flex; align-items: center; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.weak-note .status-note { flex: 1; }
.weak-note button { flex-shrink: 0; }
.recent-row { display: flex; align-items: center; justify-content: space-between; width: 100% !important; min-height: 126rpx; padding: 24rpx 4rpx; border-bottom: 1rpx solid var(--color-border); background: transparent; color: var(--color-text); font-size: 28rpx; text-align: left; }
