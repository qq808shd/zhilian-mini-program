.crumb { display:block; color:var(--color-primary); font-size:23rpx; font-weight:650; }
.group-title { margin-top:14rpx; }
.catalog-card { display:flex; width:100%; min-height:180rpx; align-items:center; justify-content:space-between; margin-top:34rpx; padding:28rpx 30rpx; border:1rpx solid #cfe0fb; border-radius:28rpx; background:#eaf2ff; text-align:left; box-shadow:0 12rpx 32rpx rgba(37,99,235,.08); }
.catalog-hover { background:#dfeaff; }
.catalog-main { display:flex; min-width:0; flex:1; align-items:center; }
.catalog-badge { display:flex; width:72rpx; height:72rpx; flex:0 0 auto; align-items:center; justify-content:center; border-radius:22rpx; background:var(--color-primary); color:#fff; font-size:31rpx; font-weight:720; }
.catalog-copy { min-width:0; margin-left:22rpx; }
.catalog-title { display:block; color:var(--color-text); font-size:32rpx; font-weight:720; }
.catalog-description { display:block; margin-top:9rpx; color:#55739d; font-size:24rpx; line-height:1.55; }
.catalog-arrow { margin-left:18rpx; color:#7296cc; font-size:48rpx; line-height:1; }
.group-section-heading { margin-top:34rpx; }
.set-list { display:flex; flex-direction:column; gap:18rpx; }
.set-card { width:100%; min-height:202rpx; padding:33rpx 34rpx; text-align:left; }
.set-hover { background:#f8fbff; }
.set-head { display:flex; align-items:center; justify-content:space-between; }
.set-name { color:var(--color-text); font-size:39rpx; font-weight:720; }
.set-arrow { color:#8aa3cb; font-size:46rpx; line-height:1; }
.set-meta { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin-top:9rpx; }
.set-range { color:var(--color-text-secondary); font-size:26rpx; }
.set-batch { padding:7rpx 13rpx; border:1rpx solid #cbdcf7; border-radius:12rpx; background:#f3f7fe; color:#426aa7; font-size:21rpx; font-weight:650; line-height:1.3; }
.set-footer { display:flex; align-items:center; justify-content:space-between; margin-top:24rpx; }
.set-status { color:var(--color-primary); font-size:23rpx; font-weight:650; }
.set-status.has-progress { color:var(--color-accent); }
.set-count { padding:7rpx 13rpx; border-radius:12rpx; background:var(--color-primary-soft); color:#3568b8; font-size:21rpx; }
