.group-title {
  margin-top: 14rpx;
}

.catalog-card {
  display: flex;
  width: 100%;
  min-height: 176rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid #cddbf2;
  border-radius: var(--radius-lg);
  background: var(--color-primary-soft);
  text-align: left;
}

.catalog-main {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
}

.catalog-badge {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.catalog-copy {
  min-width: 0;
  margin-left: 22rpx;
}

.catalog-title {
  display: block;
  color: var(--color-text);
  font-size: 31rpx;
  font-weight: 700;
}

.catalog-description {
  display: block;
  margin-top: 9rpx;
  color: #587096;
  font-size: 24rpx;
  line-height: 1.55;
}

.catalog-arrow,
.set-arrow {
  margin-left: 18rpx;
  color: var(--color-text-tertiary);
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.group-section-heading {
  margin-top: 38rpx;
}

.set-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.set-card {
  width: 100%;
  min-height: 194rpx;
  padding: 30rpx 32rpx;
  text-align: left;
}

.set-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.set-name {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 700;
}

.set-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.set-range {
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.set-batch {
  padding: 6rpx 12rpx;
  border: 1rpx solid #cbd8ec;
  border-radius: var(--radius-sm);
  background: var(--color-surface-muted);
  color: #587096;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.3;
}

.set-footer {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.set-status {
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 650;
  white-space: nowrap;
}

.set-status.has-progress {
  color: var(--color-secondary);
}

.set-progress {
  height: 8rpx;
  flex: 1;
  margin: 0 16rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: #e7ecf3;
}

.set-progress-fill {
  height: 100%;
  border-radius: 5rpx;
  background: var(--color-secondary);
}

.set-count {
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  white-space: nowrap;
}
