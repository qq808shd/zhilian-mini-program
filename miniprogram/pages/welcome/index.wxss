.welcome-page { min-height: calc(100vh - 88px); padding: 32rpx 40rpx calc(36rpx + env(safe-area-inset-bottom)); display:flex; flex-direction:column; }
.welcome-brand { display:block; text-align:center; color:var(--color-primary); font-size:40rpx; font-weight:700; letter-spacing:8rpx; }
.welcome-art { display:block; width:100%; height:390rpx; margin:8rpx 0 12rpx; }
.welcome-title { display:block; font-size:58rpx; font-weight:700; line-height:1.4; letter-spacing:-1rpx; white-space:pre-line; }
.welcome-path { display:flex; justify-content:space-between; margin-top:32rpx; color:var(--color-primary); font-size:25rpx; }
.welcome-actions { margin-top:auto; padding-top:40rpx; }
.consent-line { display:flex; align-items:center; flex-wrap:wrap; margin:12rpx 0 20rpx; font-size:24rpx; color:var(--color-text-secondary); }
.consent-check { display:flex; align-items:center; min-height:88rpx; }
.consent-check checkbox { transform:scale(.85); transform-origin:left center; }
button.legal-link { min-height:88rpx; display:flex; align-items:center; background:transparent; color:var(--color-primary); font-size:24rpx; width:auto!important; padding:0 4rpx; }
@media (max-height: 700px) { .welcome-art { height:280rpx; } .welcome-actions { padding-top:24rpx; } .welcome-title { font-size:52rpx; } }
