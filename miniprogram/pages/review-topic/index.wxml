<view class="page" wx:if="{{module}}">
  <view class="page-header"><text class="crumb">复习 / {{module.name}}</text><text class="page-title topic-title">选择复习内容</text><text class="page-subtitle">待复习较多的分类优先，按自己的节奏逐个巩固。</text></view>
  <view class="stack"><ui-entry wx:for="{{topics}}" wx:key="id" title="{{item.name}}" meta="自评掌握 {{item.masteredCount}} · 到期 {{item.dueCount}} 项" badge="{{item.learnedCount}} 个已学习" warning="{{item.dueCount > 0}}" data-id="{{item.id}}" bind:activate="onOpenTopic" /></view>
</view>
