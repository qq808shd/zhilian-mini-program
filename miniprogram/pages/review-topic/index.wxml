<view class="page" wx:if="{{module}}">
  <text class="crumb">复习 / {{module.name}}</text>
  <text class="page-title topic-title">{{module.name}}分类复习</text>
  <text class="page-subtitle">进入分类后，查看错得最多的具体题目，并可进行专项考试。</text>
  <view class="section-heading topic-heading"><text class="section-title">选择分类</text><text class="section-note">按错题情况查看</text></view>
  <view class="topic-list">
    <button wx:for="{{topics}}" wx:key="id" class="topic-card card interactive-card" hover-class="interactive-card-hover" data-id="{{item.id}}" bindtap="onOpenTopic">
      <view class="topic-content">
        <view class="topic-name-row"><text class="topic-name">{{item.name}}</text><text class="topic-arrow">›</text></view>
        <text class="topic-meta">正确率 {{item.accuracy}}% · 已答 {{item.attempts}} 次</text>
        <text class="topic-wrong">{{item.activeWrongCount}} 道待复习错题</text>
      </view>
    </button>
  </view>
</view>
