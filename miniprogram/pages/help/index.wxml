<view class="page account-page"><view class="page-header"><text class="eyebrow">帮助与反馈</text><text class="page-title">遇到问题，我们一起解决</text></view><view class="card faq" wx:for="{{faqs}}" wx:key="q"><text class="section-title">{{item.q}}</text><text class="page-subtitle">{{item.a}}</text></view><view class="section"><button class="primary-button" bindtap="onContact">联系与问题反馈</button><text class="status-note section">{{email ? '点击复制联系邮箱：' + email : '对外联系邮箱待补齐，当前未开通反馈受理渠道。'}}</text></view></view>
