.detail-title {
  margin-top: 14rpx;
}

.topic-summary {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 28rpx 10rpx;
}

.summary-item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.summary-number {
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 720;
}

.primary-number {
  color: var(--color-primary);
}

.danger-number {
  color: var(--color-danger);
}

.summary-label {
  margin-top: 7rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.summary-divider {
  width: 1rpx;
  height: 54rpx;
  background: var(--color-divider);
}

.detail-heading {
  margin-top: 40rpx;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-card {
  display: flex;
  width: 100%;
  min-height: 122rpx;
  align-items: center;
  padding: 22rpx;
  text-align: left;
}

.rank-number {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 14rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.rank-content {
  min-width: 0;
  flex: 1;
}

.rank-title {
  display: block;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

.rank-meta {
  display: block;
  margin-top: 8rpx;
  color: var(--color-danger);
  font-size: 23rpx;
  line-height: 1.45;
}

.rank-arrow {
  margin-left: 16rpx;
  color: var(--color-text-tertiary);
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}

.targeted-button.primary-button {
  width: 100%;
  margin-top: 30rpx;
}
