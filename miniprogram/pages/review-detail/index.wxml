<view class="page" wx:if="{{topic}}">
  <view class="page-header"><text class="crumb">{{module.name}} / {{topic.name}}</text><text class="page-title">让记忆慢慢稳固</text><text class="page-subtitle">自评和答题共同安排复习，同日重复正确不会直接变成掌握。</text></view>
  <view class="card metrics"><view class="metric"><text class="metric-value">{{summary.dueCount}}</text><text class="metric-label">到期复习</text></view><view class="metric"><text class="metric-value">{{summary.consolidatingCount}}</text><text class="metric-label">待巩固</text></view><view class="metric"><text class="metric-value">{{summary.masteredCount}}</text><text class="metric-label">已掌握</text></view></view>
  <view class="actions-row"><button class="primary-button" bindtap="onToday">今日复习安排</button><button class="secondary-button" bindtap="onStartWrongExam" wx:if="{{summary.consolidatingCount}}">专项巩固</button></view>
  <view wx:if="{{ranked.length}}" class="section"><text class="section-title">常错知识</text><button wx:for="{{ranked}}" wx:key="id" class="card recall-row" data-id="{{item.id}}" bindtap="onPracticeOne"><text>{{item.title}}</text><text class="status-note">累计错误 {{item.wrongCount}} 次 · {{item.status}}</text></button></view>
  <view class="section"><view class="review-filters"><button class="{{filter === 'active' ? 'chosen' : ''}}" data-value="active" bindtap="onFilter">待巩固</button><button class="{{filter === 'due' ? 'chosen' : ''}}" data-value="due" bindtap="onFilter">已到期</button><button class="{{filter === 'mastered' ? 'chosen' : ''}}" data-value="mastered" bindtap="onFilter">已掌握</button></view>
    <view class="actions-row"><button class="text-button" data-value="frequent" bindtap="onSort">{{sort === 'frequent' ? '✓ ' : ''}}常错优先</button><button class="text-button" data-value="recent" bindtap="onSort">{{sort === 'recent' ? '✓ ' : ''}}最近检验</button></view>
    <view wx:for="{{items}}" wx:key="id" class="card recall-row"><text class="section-title">{{item.title}}</text><text class="page-subtitle">{{item.status}} · {{item.date}}</text><text class="status-note">累计错误 {{item.wrongCount}} 次</text><view class="actions-row"><button class="text-button" data-id="{{item.id}}" bindtap="onOpenKnowledge">查看解析</button><button class="secondary-button" data-id="{{item.id}}" bindtap="onPracticeOne">{{item.questionId ? '检验记忆' : '回忆自评'}}</button></view></view>
    <button wx:if="{{hasMore}}" class="secondary-button section" bindtap="onMore">继续查看</button>
    <ui-state wx:if="{{!items.length}}" title="这里暂时没有记录" description="完成正式学习或练习后，会按回忆情况安排后续复习。" action="去学习" bind:action="onStudy" />
  </view>
</view>
