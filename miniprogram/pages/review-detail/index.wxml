<view class="page" wx:if="{{topic}}">
  <view class="page-header"><text class="crumb">{{module.name}} / {{topic.name}}</text><text class="page-title">已学内容</text><text class="page-subtitle">已学习 {{summary.learnedCount}} 个 · 今日待复习 {{summary.dueCount}} 个</text></view>
  <button wx:if="{{summary.dueCount}}" class="primary-button" bindtap="onToday">开始今日复习</button>
  <view class="list-heading"><picker mode="selector" range="{{filters}}" range-key="label" value="{{filterIndex}}" bindchange="onFilter"><view class="filter-control">{{filters[filterIndex].label}} ⌄</view></picker><text class="status-note">{{total}} 个知识</text></view>
  <view wx:for="{{items}}" wx:key="id" class="card recall-row"><text class="section-title">{{item.title}}</text><text class="page-subtitle">{{item.degreeLabel}} · {{item.date}}</text><view class="actions-row"><button class="text-button" data-id="{{item.id}}" bindtap="onOpenKnowledge">查看与调整</button><button wx:if="{{item.due}}" class="secondary-button" data-id="{{item.id}}" bindtap="onPracticeOne">复习这条</button></view></view>
  <button wx:if="{{hasMore}}" class="secondary-button section" bindtap="onMore">继续查看</button>
  <ui-state wx:if="{{!items.length}}" title="当前没有这类内容" description="选择其他学习程度，或继续学习新知识。" action="去学习" bind:action="onStudy" />
</view>
