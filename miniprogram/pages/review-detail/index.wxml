<view class="page" wx:if="{{topic}}">
  <text class="crumb">复习 / {{module.name}} / {{topic.name}}</text>
  <text class="page-title detail-title">{{topic.name}}错题复习</text>
  <view class="topic-summary card">
    <view class="summary-item"><text class="summary-number primary-number">{{summary.accuracy}}%</text><text class="summary-label">正确率</text></view>
    <view class="summary-divider"></view>
    <view class="summary-item"><text class="summary-number danger-number">{{summary.activeWrongCount}}</text><text class="summary-label">待复习错题</text></view>
    <view class="summary-divider"></view>
    <view class="summary-item"><text class="summary-number">{{summary.attempts}}</text><text class="summary-label">累计作答</text></view>
  </view>
  <view class="section-heading detail-heading"><text class="section-title">错得最多的知识点</text><text class="section-note">按错误次数排序</text></view>
  <view wx:if="{{ranked.length}}" class="rank-list">
    <button wx:for="{{ranked}}" wx:key="id" class="rank-card card interactive-card" hover-class="interactive-card-hover" data-id="{{item.knowledgeId}}" bindtap="onOpenKnowledge">
      <view class="rank-number">{{index + 1}}</view>
      <view class="rank-content"><text class="rank-title">{{item.title}}</text><text class="rank-meta">错 {{item.wrong}} 次 · 错误率 {{item.errorRate}}% · {{item.activeWrongCount}} 道待复习</text></view>
      <text class="rank-arrow">›</text>
    </button>
  </view>
  <view wx:else class="card empty-state">
    <text class="empty-mark">✓</text>
    <text class="empty-title">这里暂时没有待复习错题</text>
    <text class="empty-description">完成这个分类的考试后，选错的知识点会出现在这里。</text>
  </view>
  <button wx:if="{{summary.activeWrongCount}}" class="primary-button targeted-button" hover-class="button-pressed" bindtap="onStartWrongExam">只考这些错题</button>
</view>
