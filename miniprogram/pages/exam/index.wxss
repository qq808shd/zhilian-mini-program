@import "../../styles/learning-experience.wxss";
.exam-page {
  padding-top: 34rpx;
}

.exam-title {
  margin-top: 10rpx;
}

.setup-section {
  margin-top: 4rpx;
}

.setup-label {
  display: block;
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 680;
}

.count-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.count-choice {
  display: flex;
  min-height: 98rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border: 2rpx solid var(--color-primary-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.2;
}

.count-choice.active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
}

.choice-state {
  margin-top: 7rpx;
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 600;
}

.exam-tip {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 30rpx;
  padding: 24rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.65;
}

.tip-mark {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.start-button.primary-button {
  width: 100%;
  margin-top: 28rpx;
}

.question-card {
  min-height: 0;
  margin-top: 24rpx;
  padding: 32rpx 28rpx 30rpx;
}

.question-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.question-type {
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.question-state {
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.question-stem {
  display: block;
  margin-top: 26rpx;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.68;
  word-break: break-word;
}

.option-list {
  margin-top: 34rpx;
}

.option-list .option {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  align-items: center;
  margin-top: 16rpx;
  padding: 17rpx 18rpx;
  border: 2rpx solid var(--color-primary-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  text-align: left;
  transition: transform 100ms ease, background-color 160ms ease, border-color 160ms ease;
}

.option-hover {
  background: var(--color-surface-muted);
  transform: scale(0.993);
}

.option.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  box-shadow: inset 0 0 0 1rpx transparent;
}

.option-id {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border: 1rpx solid var(--color-primary-border);
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 23rpx;
  font-weight: 650;
}

.option.selected .option-id {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-surface);
}

.option-text {
  min-width: 0;
  flex: 1;
  font-size: 28rpx;
  line-height: 1.58;
}

.option-state {
  flex: 0 0 auto;
  margin-left: 14rpx;
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.answer-hint {
  display: block;
  min-height: 56rpx;
  padding-top: 18rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
  text-align: center;
}

.exam-actions,
.result-actions {
  display: flex;
  gap: 16rpx;
}

.exam-actions button,
.result-actions button {
  min-width: 0;
  flex: 1;
}

.previous-button[disabled] {
  border-color: var(--color-border);
  background: var(--color-surface-muted);
  color: var(--color-disabled);
}

.result-hero {
  padding: 34rpx 34rpx 30rpx;
  text-align: center;
}

.result-eyebrow {
  display: block;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 650;
}

.score-line {
  margin-top: 6rpx;
}

.score-number {
  color: var(--color-text);
  font-size: 88rpx;
  font-weight: 750;
  letter-spacing: -3rpx;
}

.score-unit {
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.score-description {
  display: block;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.success-text,
.correct-text {
  color: var(--color-success);
}

.danger-text,
.wrong-text {
  color: var(--color-danger);
}

.result-item {
  margin-top: 18rpx;
  padding: 26rpx;
}

.result-item.correct {
  border-top: 5rpx solid var(--color-success);
}

.result-item.wrong {
  border-top: 5rpx solid var(--color-danger-border);
}

.result-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.result-status {
  font-size: 23rpx;
  font-weight: 700;
}

.correct .result-status {
  color: var(--color-success);
}

.wrong .result-status {
  color: var(--color-danger);
}

.result-category {
  overflow: hidden;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: normal;
}

.result-stem {
  display: block;
  margin-top: 18rpx;
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.62;
}

.answers-panel {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--color-surface-muted);
}

.answer-line {
  display: flex;
  gap: 18rpx;
  padding: 7rpx 0;
  font-size: 25rpx;
  line-height: 1.55;
}

.answer-label {
  width: 112rpx;
  flex: 0 0 auto;
  color: var(--color-text-secondary);
}

.answer-value {
  min-width: 0;
  flex: 1;
  font-weight: 650;
}

.explanation {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-divider);
}

.explanation-label {
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.explanation-text {
  display: block;
  margin-top: 9rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.72;
}

.knowledge-link {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 0 4rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.2;
  text-align: left;
}

.result-actions {
  margin-top: 28rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.back-link { justify-content: flex-start !important; margin-bottom: 16rpx; }
.mode-intro { display: flex; gap: 24rpx; padding: 0 0 40rpx; }
.mode-intro > view { flex: 1; padding-left: 18rpx; border-left: 3rpx solid var(--color-primary-border); }
.mode-intro .section-title { font-size: 28rpx; }
.setup-section + .setup-section { margin-top: 32rpx; }
.mode-row { display: flex; flex-direction: column; gap: 16rpx; margin-top: 16rpx; }
.mode-choice { display: block; width: 100% !important; padding: 24rpx; text-align: left; border: 2rpx solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
.mode-choice.active { border-color: var(--color-primary); background: var(--color-primary-soft); }
.mode-name { display: block; color: var(--color-text); font-size: 29rpx; font-weight: 650; margin-bottom: 8rpx; }
.setup-instruction { margin-top: 16rpx; }
.exam-top { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.clock { color: var(--color-text-secondary); font-size: 26rpx; font-variant-numeric: tabular-nums; }
.question-count { display: flex; align-items: baseline; gap: 12rpx; margin-top: 12rpx; }
.current-number { font-size: 50rpx; font-weight: 650; }
.total-number { color: var(--color-text-secondary); font-size: 28rpx; }
.question-count button { margin-left: auto; }
.mark-button.text-button { font-size: 23rpx; min-height: 88rpx; }
.question-meta { margin-top: -18rpx; }
.question-stem { margin-top: 12rpx; white-space: pre-wrap; }
.option-state { max-width: 70rpx; font-size: 23rpx; line-height: 1.4; }
.option.option-correct { background: var(--color-success-soft); border-color: var(--color-success); }
.option.option-wrong { background: var(--color-danger-soft); border-color: var(--color-danger); }
.option.option-wrong .option-id { background: var(--color-danger); border-color: var(--color-danger); }
.option.option-wrong .option-state { color: var(--color-danger); }
.inline-feedback { padding: 28rpx; border-radius: var(--radius-lg); margin-top: 24rpx; }
.feedback-correct { background: var(--color-success-soft); }
.feedback-wrong { background: var(--color-danger-soft); }
.feedback-title { display: block; font-size: 29rpx; font-weight: 650; margin-bottom: 12rpx; }
.feedback-correct .feedback-title { color: var(--color-success); }
.feedback-wrong .feedback-title { color: var(--color-danger); }
.inline-feedback .explanation-label { display: block; margin-top: 24rpx; }
.explanation-text { white-space: pre-wrap; }
.exam-actions { margin-top: 16rpx; }
.sheet { margin-top: 24rpx; padding: 24rpx; }
.sheet-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12rpx; margin-top: 20rpx; }
.sheet-cell { display: flex; width: 100% !important; min-height: 96rpx; padding: 10rpx 0; flex-direction: column; align-items: center; justify-content: center; border: 2rpx solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-text); background: var(--color-surface); font-size: 26rpx; }
.sheet-cell.answered { background: var(--color-primary-soft); }
.sheet-cell.current { border-color: var(--color-primary); }
.sheet-state { display: block; font-size: 21rpx; margin-top: 6rpx; }
.result-hero { background: var(--color-primary-soft); border-color: var(--color-primary-border); }
.result-hero progress-meter { margin-top: 24rpx; display: block; }
.recommendation { margin-top: 32rpx; }
.recommendation > .status-note { margin-top: 12rpx; }
.filter-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.filter-chip { width: auto !important; min-height: 88rpx; padding: 18rpx 24rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); border: 1rpx solid var(--color-border); background: var(--color-surface); color: var(--color-text-secondary); font-size: 25rpx; }
.filter-chip.active { border-color: var(--color-primary); background: var(--color-primary-soft); color: var(--color-primary); font-weight: 650; }
.saved-note { display: block; margin-top: 24rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.6; }
.performance-row { display: flex; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-border); font-size: 26rpx; }
.reset-link { margin: 32rpx auto 0; }

.result-weak { margin-bottom: 24rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--color-border); }

/* Custom navigation owns the bottom safe area; reserve its full height once. */
.page { padding-bottom:calc(48px + 32rpx + env(safe-area-inset-bottom)); }

/* V6: one recommendation, one main result action. */
.exam-page { padding-top:24rpx; }
.exam-page .exam-title { font-size:42rpx; }
.exam-page .result-hero { background:var(--color-surface); border-color:var(--color-border); padding:32rpx; border-radius:24rpx; text-align:left; }
.result-overview { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16rpx; margin-top:24rpx; }
.result-overview > view { min-width:0; }
.result-number { display:block; font-size:44rpx; font-weight:600; line-height:1.4; font-variant-numeric:tabular-nums; white-space:nowrap; }
.result-denominator { font-size:26rpx; font-weight:400; color:var(--color-text-secondary); }
.result-time { font-size:36rpx; line-height:1.7; }
.weak-list { margin-top:16rpx; }
.weak-list .ux-link-row { border-bottom:1rpx solid var(--color-border); gap:16rpx; }
.system-feedback { display:block; margin-top:24rpx; padding:24rpx; border-radius:16rpx; background:var(--color-primary-soft); color:var(--color-primary-dark); font-size:24rpx; line-height:1.6; }
.result-primary { margin-top:32rpx; }
.result-secondary { display:flex; flex-wrap:wrap; justify-content:space-between; gap:16rpx; margin-top:8rpx; }
.exam-page .exam-tip { padding:0; margin-top:24rpx; }
.exam-page .exam-tip .section-title { font-size:28rpx; }
.exam-page .setup-instruction { margin-top:8rpx; }
.exam-page .question-card { padding:32rpx; border-radius:28rpx; }
.exam-page .option { padding:16rpx; }
.exam-page .count-choice { width:0; min-width:0; min-height:88rpx; }
.exam-page .ux-note { white-space:pre-line; }
