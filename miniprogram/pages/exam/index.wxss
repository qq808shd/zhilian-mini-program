.exam-page { padding-top:40rpx; }
.back-link,.crumb { display:block; color:var(--color-primary); font-size:25rpx; font-weight:650; }
.back-link { margin-bottom:24rpx; }
.exam-select-list { display:flex; flex-direction:column; gap:18rpx; }
.select-card { display:flex; width:100%; min-height:154rpx; align-items:center; padding:25rpx 28rpx; text-align:left; }
.select-hover { background:#f8fbff; }
.select-symbol { display:flex; width:68rpx; height:68rpx; align-items:center; justify-content:center; margin-right:20rpx; border-radius:18rpx; background:var(--color-primary-soft); color:var(--color-primary); font-size:34rpx; font-weight:700; }
.select-content { flex:1; min-width:0; }.select-name { display:block; color:var(--color-text); font-size:34rpx; font-weight:700; }.select-desc { display:block; margin-top:8rpx; color:var(--color-text-secondary); font-size:25rpx; line-height:1.45; }.select-arrow { color:#8aa3cb; font-size:46rpx; }
.setup-label { display:block; margin-top:36rpx; color:var(--color-text); font-size:30rpx; font-weight:700; }.count-row { display:flex; gap:16rpx; margin-top:20rpx; }.count-choice { display:flex; min-height:88rpx; flex:1; align-items:center; justify-content:center; padding:0 20rpx; border:2rpx solid #c9dcff; border-radius:20rpx; background:#fff; color:#4774b8; font-size:27rpx; font-weight:600; line-height:1.2; }.count-choice.active { border-color:var(--color-primary); background:var(--color-primary); color:#fff; }.exam-tip { display:flex; align-items:flex-start; gap:14rpx; margin-top:32rpx; padding:24rpx; color:#48658d; font-size:25rpx; line-height:1.6; }.tip-mark { display:flex; width:32rpx; height:32rpx; flex:0 0 auto; align-items:center; justify-content:center; border-radius:50%; background:var(--color-primary-soft); color:var(--color-primary); font-weight:700; }.start-button.primary-button { width:100%; margin-top:28rpx; }
.progress-header { margin-top:8rpx; }.progress-text-row { display:flex; justify-content:space-between; color:#4774b8; font-size:24rpx; font-weight:650; }.progress-track,.score-bar { height:10rpx; margin-top:16rpx; overflow:hidden; border-radius:6rpx; background:#dce9fb; }.progress-value,.score-bar-value { height:100%; border-radius:6rpx; background:var(--color-primary); }.question-card { min-height:570rpx; margin-top:26rpx; padding:34rpx 30rpx; }.question-type { color:var(--color-primary); font-size:23rpx; font-weight:700; }.question-stem { display:block; margin-top:24rpx; color:var(--color-text); font-size:35rpx; font-weight:650; line-height:1.6; }.option-list { margin-top:36rpx; }.option-list .option { display:flex; width:100%; min-height:98rpx; align-items:center; margin-top:16rpx; padding:16rpx 20rpx; border:2rpx solid #dce7f7; border-radius:20rpx; background:#fff; color:var(--color-text); text-align:left; }.option.selected { border-color:var(--color-primary); background:var(--color-primary-soft); }.option-id { display:flex; width:42rpx; height:42rpx; align-items:center; justify-content:center; margin-right:17rpx; border-radius:50%; background:#edf3fc; color:#51709b; font-size:23rpx; }.option.selected .option-id { background:var(--color-primary); color:#fff; }.option-text { flex:1; font-size:27rpx; line-height:1.5; }.exam-actions,.result-actions { display:flex; gap:18rpx; margin-top:28rpx; }.exam-actions button,.result-actions button { flex:1; }.result-hero { padding:36rpx; text-align:center; }.result-eyebrow { display:block; color:var(--color-primary); font-size:24rpx; font-weight:700; }.score-line { margin-top:12rpx; }.score-number { color:var(--color-text); font-size:92rpx; font-weight:750; }.score-unit { color:var(--color-primary); font-size:36rpx; }.score-description { display:block; color:var(--color-text-secondary); font-size:26rpx; }.result-item { margin-top:18rpx; padding:26rpx; }.result-item.correct { border-left:8rpx solid var(--color-accent); }.result-item.wrong { border-left:8rpx solid var(--color-danger); }.result-item-header { display:flex; justify-content:space-between; font-size:23rpx; font-weight:700; }.correct .result-status,.correct-text { color:var(--color-accent); }.wrong .result-status,.wrong-text { color:var(--color-danger); }.result-category,.answer-label { color:var(--color-text-secondary); }.result-stem { display:block; margin-top:16rpx; color:var(--color-text); font-size:29rpx; font-weight:650; line-height:1.55; }.answer-line { display:flex; margin-top:14rpx; gap:18rpx; font-size:25rpx; line-height:1.5; }.answer-value { flex:1; }.explanation { margin-top:20rpx; padding-top:20rpx; border-top:1rpx solid #e4ecf8; }.explanation-label { color:var(--color-primary); font-size:23rpx; font-weight:700; }.explanation-text { display:block; margin-top:8rpx; color:#465c79; font-size:25rpx; line-height:1.65; }.knowledge-link { display:flex; min-height:88rpx; align-items:center; justify-content:flex-start; margin-top:16rpx; padding:0 8rpx; background:transparent; color:var(--color-primary); font-size:24rpx; font-weight:600; line-height:1.2; }
