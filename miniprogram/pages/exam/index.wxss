.exam-page {
  padding-top: 34rpx;
}

.exam-title {
  margin-top: 10rpx;
}

.back-link {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 650;
}

.exam-select-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.select-card {
  display: flex;
  width: 100%;
  min-height: 158rpx;
  align-items: center;
  padding: 26rpx 28rpx;
  text-align: left;
}

.select-symbol {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.select-content {
  min-width: 0;
  flex: 1;
}

.select-name {
  display: block;
  color: var(--color-text);
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.4;
}

.select-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
}

.select-arrow {
  margin-left: 18rpx;
  color: var(--color-text-tertiary);
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.setup-section {
  margin-top: 4rpx;
}

.setup-label {
  display: block;
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 680;
}

.count-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.count-choice {
  display: flex;
  min-height: 98rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border: 2rpx solid #c7d5eb;
  border-radius: var(--radius-md);
  background: #ffffff;
  color: #4b6285;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.2;
}

.count-choice.active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
}

.choice-state {
  margin-top: 7rpx;
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 600;
}

.exam-tip {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 30rpx;
  padding: 24rpx;
  color: #465a78;
  font-size: 25rpx;
  line-height: 1.65;
}

.tip-mark {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 700;
}

.start-button.primary-button {
  width: 100%;
  margin-top: 28rpx;
}

.progress-header {
  margin-top: 8rpx;
  padding: 0 4rpx;
}

.progress-text-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  font-weight: 620;
}

.progress-category {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress-count {
  flex: 0 0 auto;
  color: var(--color-primary);
}

.progress-track,
.score-bar {
  height: 8rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: #dfe6f0;
}

.progress-value,
.score-bar-value {
  height: 100%;
  border-radius: 5rpx;
  background: var(--color-primary);
  transition: width 220ms ease;
}

.question-card {
  min-height: 570rpx;
  margin-top: 24rpx;
  padding: 32rpx 28rpx 30rpx;
}

.question-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.question-type {
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.question-state {
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.question-stem {
  display: block;
  margin-top: 26rpx;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.68;
  word-break: break-word;
}

.option-list {
  margin-top: 34rpx;
}

.option-list .option {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  align-items: center;
  margin-top: 16rpx;
  padding: 17rpx 18rpx;
  border: 2rpx solid #d8e0ec;
  border-radius: var(--radius-md);
  background: #ffffff;
  color: var(--color-text);
  text-align: left;
  transition: transform 100ms ease, background-color 160ms ease, border-color 160ms ease;
}

.option-hover {
  background: var(--color-surface-muted);
  transform: scale(0.993);
}

.option.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  box-shadow: inset 0 0 0 1rpx rgba(36, 87, 214, 0.08);
}

.option-id {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border: 1rpx solid #cfd9e7;
  border-radius: 50%;
  background: #ffffff;
  color: #52627a;
  font-size: 23rpx;
  font-weight: 650;
}

.option.selected .option-id {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #ffffff;
}

.option-text {
  min-width: 0;
  flex: 1;
  font-size: 28rpx;
  line-height: 1.58;
}

.option-state {
  flex: 0 0 auto;
  margin-left: 14rpx;
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 700;
}

.answer-hint {
  display: block;
  min-height: 56rpx;
  padding-top: 18rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
  text-align: center;
}

.exam-actions,
.result-actions {
  display: flex;
  gap: 16rpx;
}

.exam-actions button,
.result-actions button {
  min-width: 0;
  flex: 1;
}

.previous-button[disabled] {
  border-color: var(--color-border);
  background: var(--color-surface-muted);
  color: var(--color-disabled);
}

.result-hero {
  padding: 34rpx 34rpx 30rpx;
  text-align: center;
}

.result-mark {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: 750;
}

.result-mark.has-wrong {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.result-mark.all-correct {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.result-eyebrow {
  display: block;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 650;
}

.score-line {
  margin-top: 6rpx;
}

.score-number {
  color: var(--color-text);
  font-size: 88rpx;
  font-weight: 750;
  letter-spacing: -3rpx;
}

.score-unit {
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.score-description {
  display: block;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.score-stats {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--color-divider);
}

.score-stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.score-stat-number {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 720;
}

.score-stat-label {
  margin-top: 5rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
}

.score-divider {
  width: 1rpx;
  height: 52rpx;
  background: var(--color-divider);
}

.success-text,
.correct-text {
  color: var(--color-success);
}

.danger-text,
.wrong-text {
  color: var(--color-danger);
}

.result-item {
  margin-top: 18rpx;
  padding: 26rpx;
}

.result-item.correct {
  border-top: 5rpx solid #81c9ad;
}

.result-item.wrong {
  border-top: 5rpx solid #e19da1;
}

.result-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.result-status-wrap {
  display: flex;
  align-items: center;
}

.result-status-mark {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  margin-right: 9rpx;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 750;
}

.correct .result-status-mark {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.wrong .result-status-mark {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.result-status {
  font-size: 23rpx;
  font-weight: 700;
}

.correct .result-status {
  color: var(--color-success);
}

.wrong .result-status {
  color: var(--color-danger);
}

.result-category {
  overflow: hidden;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-stem {
  display: block;
  margin-top: 18rpx;
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.62;
}

.answers-panel {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--color-surface-muted);
}

.answer-line {
  display: flex;
  gap: 18rpx;
  padding: 7rpx 0;
  font-size: 25rpx;
  line-height: 1.55;
}

.answer-label {
  width: 112rpx;
  flex: 0 0 auto;
  color: var(--color-text-secondary);
}

.answer-value {
  min-width: 0;
  flex: 1;
  font-weight: 650;
}

.explanation {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-divider);
}

.explanation-label {
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.explanation-text {
  display: block;
  margin-top: 9rpx;
  color: #40506a;
  font-size: 26rpx;
  line-height: 1.72;
}

.knowledge-link {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 0 4rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.2;
  text-align: left;
}

.result-actions {
  margin-top: 28rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
