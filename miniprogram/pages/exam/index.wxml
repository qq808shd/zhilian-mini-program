<view class="page exam-page">
  <block wx:if="{{state === 'module'}}"><view class="page-header"><text class="page-title">选择考试模块</text><text class="page-subtitle">先确定模块，再从具体分类的题库中随机抽题。</text></view><view class="exam-select-list"><button wx:for="{{modules}}" wx:key="id" class="select-card card" style="width: 100%;" hover-class="select-hover" data-id="{{item.id}}" bindtap="onModuleTap"><view class="select-symbol">{{item.symbol}}</view><view class="select-content"><text class="select-name">{{item.name}}</text><text class="select-desc">{{item.description}}</text></view><text class="select-arrow">›</text></button></view></block>
  <block wx:elif="{{state === 'topic'}}"><text class="back-link" bindtap="onBackModules">‹ 返回模块</text><view class="page-header"><text class="page-title">{{selectedModule.name}}考试</text><text class="page-subtitle">选择一个具体分类开始组卷。</text></view><view class="exam-select-list"><button wx:for="{{topics}}" wx:key="id" class="select-card card" style="width: 100%;" hover-class="select-hover" data-id="{{item.id}}" bindtap="onTopicTap"><view class="select-content"><text class="select-name">{{item.name}}</text><text class="select-desc">{{item.description}}</text></view><text class="select-arrow">›</text></button></view></block>
  <block wx:elif="{{state === 'setup'}}"><text class="back-link" bindtap="onBackTopics">‹ 返回分类</text><view class="page-header"><text class="crumb">考试 / {{selectedModule.name}} / {{selectedTopic.name}}</text><text class="page-title">{{selectedTopic.name}}组卷</text><text class="page-subtitle">从 {{availableCount}} 道题中随机抽取，交卷后查看解析。</text></view><text class="setup-label">题目数量</text><view class="count-row"><button wx:for="{{questionCountOptions}}" wx:key="value" class="count-choice {{questionCount === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onCountTap">{{item.value === 0 ? '全部' : (item.value > availableCount ? availableCount + ' 题' : item.label)}}</button></view><view class="exam-tip card"><text class="tip-mark">i</text><text>本次只考“{{selectedTopic.name}}”分类；选错的题会自动进入该分类的错题复习。</text></view><button class="primary-button start-button" bindtap="onStartExam">开始考试</button></block>
  <block wx:elif="{{state === 'exam' && currentQuestion}}"><view class="progress-header"><view class="progress-text-row"><text class="progress-category">{{currentQuestion.moduleName}} / {{currentQuestion.topicName}}</text><text class="progress-count">{{currentIndex + 1}} / {{examQuestions.length}}</text></view><view class="progress-track"><view class="progress-value" style="width: {{((currentIndex + 1) / examQuestions.length) * 100}}%;"></view></view></view><view class="question-card card"><text class="question-type">单项选择题</text><text class="question-stem">{{currentQuestion.stem}}</text><view class="option-list"><button wx:for="{{currentQuestion.options}}" wx:key="id" class="option {{selectedAnswer === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onChooseOption"><text class="option-id">{{item.id}}</text><text class="option-text">{{item.text}}</text></button></view></view><view class="exam-actions"><button class="secondary-button previous-button" disabled="{{currentIndex === 0}}" bindtap="onPrevious">上一题</button><button class="primary-button next-button" bindtap="onNext">{{currentIndex === examQuestions.length - 1 ? '交卷' : '下一题'}}</button></view></block>
  <block wx:elif="{{state === 'result' && resultSummary}}"><view class="result-hero card"><text class="result-eyebrow">本次考试完成</text><view class="score-line"><text class="score-number">{{resultSummary.accuracy}}</text><text class="score-unit">%</text></view><text class="score-description">答对 {{resultSummary.correctCount}} 题，答错 {{resultSummary.wrongCount}} 题</text><view class="score-bar"><view class="score-bar-value" style="width: {{resultSummary.accuracy}}%;"></view></view></view><view class="section"><view class="section-heading"><text class="section-title">答题解析</text><text class="section-note">共 {{resultItems.length}} 题</text></view><view wx:for="{{resultItems}}" wx:key="id" class="result-item card {{item.isCorrect ? 'correct' : 'wrong'}}"><view class="result-item-header"><text class="result-status">{{item.isCorrect ? '回答正确' : '回答错误'}}</text><text class="result-category">{{item.topicName}}</text></view><text class="result-stem">{{index + 1}}. {{item.stem}}</text><view class="answer-line"><text class="answer-label">你的答案</text><text class="answer-value {{item.isCorrect ? 'correct-text' : 'wrong-text'}}">{{item.selectedAnswer}}. {{item.selectedText}}</text></view><view wx:if="{{!item.isCorrect}}" class="answer-line"><text class="answer-label">正确答案</text><text class="answer-value correct-text">{{item.answer}}. {{item.correctText}}</text></view><view class="explanation"><text class="explanation-label">解析</text><text class="explanation-text">{{item.explanation}}</text></view><button class="knowledge-link" data-id="{{item.knowledgeId}}" bindtap="onOpenKnowledge">复习对应知识点 ›</button></view></view><view class="result-actions"><button class="secondary-button" bindtap="onBackToSetup">重新选题</button><button wx:if="{{resultSummary.wrongCount > 0}}" class="primary-button" bindtap="onRetryWrong">重练本次错题</button></view></block>
</view>
