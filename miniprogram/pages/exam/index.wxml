<view class="page exam-page">
  <block wx:if="{{state === 'module'}}">
    <view class="page-header">
      <text class="eyebrow">分类组卷</text>
      <text class="page-title exam-title">选择考试模块</text>
      <text class="page-subtitle">先确定模块，再从具体分类的题库中随机抽题。</text>
    </view>
    <view class="exam-select-list">
      <button wx:for="{{modules}}" wx:key="id" class="select-card card interactive-card" hover-class="interactive-card-hover" data-id="{{item.id}}" bindtap="onModuleTap">
        <view class="select-symbol">{{item.symbol}}</view>
        <view class="select-content">
          <text class="select-name">{{item.name}}</text>
          <text class="select-desc">{{item.description}}</text>
        </view>
        <text class="select-arrow">›</text>
      </button>
    </view>
  </block>

  <block wx:elif="{{state === 'topic'}}">
    <button class="back-link" hover-class="button-pressed" bindtap="onBackModules">‹ 返回模块</button>
    <view class="page-header">
      <text class="eyebrow">{{selectedModule.name}}</text>
      <text class="page-title exam-title">选择考试分类</text>
      <text class="page-subtitle">从一个具体分类开始本次练习。</text>
    </view>
    <view class="exam-select-list">
      <button wx:for="{{topics}}" wx:key="id" class="select-card card interactive-card" hover-class="interactive-card-hover" data-id="{{item.id}}" bindtap="onTopicTap">
        <view class="select-content">
          <text class="select-name">{{item.name}}</text>
          <text class="select-desc">{{item.description}}</text>
        </view>
        <text class="select-arrow">›</text>
      </button>
    </view>
  </block>

  <block wx:elif="{{state === 'setup'}}">
    <button class="back-link" hover-class="button-pressed" bindtap="onBackTopics">‹ 返回分类</button>
    <view class="page-header">
      <text class="crumb">考试 / {{selectedModule.name}} / {{selectedTopic.name}}</text>
      <text class="page-title exam-title">{{selectedTopic.name}}组卷</text>
      <text class="page-subtitle">从 {{availableCount}} 道题中随机抽取，交卷后统一查看答案与解析。</text>
    </view>
    <view class="setup-section">
      <text class="setup-label">题目数量</text>
      <view class="count-row">
        <button wx:for="{{questionCountOptions}}" wx:key="value" class="count-choice {{questionCount === item.value ? 'active' : ''}}" hover-class="button-pressed" data-value="{{item.value}}" bindtap="onCountTap">
          <text>{{item.label}}</text>
          <text wx:if="{{questionCount === item.value}}" class="choice-state">已选</text>
        </button>
      </view>
    </view>
    <view class="exam-tip card">
      <text class="tip-mark">i</text>
      <text>本次只考“{{selectedTopic.name}}”分类；选错的题会自动进入该分类的错题复习。</text>
    </view>
    <button class="primary-button start-button" hover-class="button-pressed" bindtap="onStartExam">开始考试</button>
  </block>

  <block wx:elif="{{state === 'exam' && currentQuestion}}">
    <view class="progress-header">
      <view class="progress-text-row">
        <text class="progress-category">{{currentQuestion.moduleName}} / {{currentQuestion.topicName}}</text>
        <text class="progress-count">第 {{currentIndex + 1}} 题 / 共 {{examQuestions.length}} 题</text>
      </view>
      <view class="progress-track"><view class="progress-value" style="width: {{((currentIndex + 1) / examQuestions.length) * 100}}%;"></view></view>
    </view>
    <view class="question-card card">
      <view class="question-meta"><text class="question-type">单项选择题</text><text class="question-state">选择 1 个答案</text></view>
      <text class="question-stem">{{currentQuestion.stem}}</text>
      <view class="option-list">
        <button wx:for="{{currentQuestion.options}}" wx:key="id" class="option {{selectedAnswer === item.id ? 'selected' : ''}}" hover-class="option-hover" data-id="{{item.id}}" bindtap="onChooseOption">
          <text class="option-id">{{item.id}}</text>
          <text class="option-text">{{item.text}}</text>
          <text wx:if="{{selectedAnswer === item.id}}" class="option-state">已选</text>
        </button>
      </view>
    </view>
    <text class="answer-hint">{{selectedAnswer ? '答案已选择，可以继续' : '请选择一个答案后继续'}}</text>
    <view class="exam-actions">
      <button class="secondary-button previous-button" hover-class="button-pressed" disabled="{{currentIndex === 0}}" bindtap="onPrevious">上一题</button>
      <button class="primary-button next-button" hover-class="button-pressed" bindtap="onNext">{{currentIndex === examQuestions.length - 1 ? '交卷' : '下一题'}}</button>
    </view>
  </block>

  <block wx:elif="{{state === 'result' && resultSummary}}">
    <view class="result-hero card">
      <view class="result-mark {{resultSummary.wrongCount ? 'has-wrong' : 'all-correct'}}">{{resultSummary.wrongCount ? '!' : '✓'}}</view>
      <text class="result-eyebrow">本次考试完成</text>
      <view class="score-line"><text class="score-number">{{resultSummary.accuracy}}</text><text class="score-unit">%</text></view>
      <text class="score-description">答对 {{resultSummary.correctCount}} 题，答错 {{resultSummary.wrongCount}} 题</text>
      <view class="score-bar"><view class="score-bar-value" style="width: {{resultSummary.accuracy}}%;"></view></view>
      <view class="score-stats">
        <view class="score-stat"><text class="score-stat-number success-text">{{resultSummary.correctCount}}</text><text class="score-stat-label">正确</text></view>
        <view class="score-divider"></view>
        <view class="score-stat"><text class="score-stat-number danger-text">{{resultSummary.wrongCount}}</text><text class="score-stat-label">错误</text></view>
        <view class="score-divider"></view>
        <view class="score-stat"><text class="score-stat-number">{{resultSummary.totalCount}}</text><text class="score-stat-label">总题数</text></view>
      </view>
    </view>
    <view class="section">
      <view class="section-heading"><text class="section-title">答题解析</text><text class="section-note">共 {{resultItems.length}} 题</text></view>
      <view wx:for="{{resultItems}}" wx:key="id" class="result-item card {{item.isCorrect ? 'correct' : 'wrong'}}">
        <view class="result-item-header">
          <view class="result-status-wrap"><text class="result-status-mark">{{item.isCorrect ? '✓' : '×'}}</text><text class="result-status">{{item.isCorrect ? '回答正确' : '回答错误'}}</text></view>
          <text class="result-category">{{item.topicName}}</text>
        </view>
        <text class="result-stem">{{index + 1}}. {{item.stem}}</text>
        <view class="answers-panel">
          <view class="answer-line">
            <text class="answer-label">我的答案</text>
            <text class="answer-value {{item.isCorrect ? 'correct-text' : 'wrong-text'}}">{{item.selectedAnswer}}. {{item.selectedText}}</text>
          </view>
          <view wx:if="{{!item.isCorrect}}" class="answer-line">
            <text class="answer-label">正确答案</text>
            <text class="answer-value correct-text">{{item.answer}}. {{item.correctText}}</text>
          </view>
        </view>
        <view class="explanation">
          <text class="explanation-label">解析</text>
          <text class="explanation-text">{{item.explanation}}</text>
        </view>
        <button class="knowledge-link" hover-class="button-pressed" data-id="{{item.knowledgeId}}" bindtap="onOpenKnowledge">复习对应知识点 <text>›</text></button>
      </view>
    </view>
    <view class="result-actions">
      <button class="secondary-button" hover-class="button-pressed" bindtap="onBackToSetup">重新选题</button>
      <button wx:if="{{resultSummary.wrongCount > 0}}" class="primary-button" hover-class="button-pressed" bindtap="onRetryWrong">重练本次错题</button>
    </view>
  </block>
</view>
